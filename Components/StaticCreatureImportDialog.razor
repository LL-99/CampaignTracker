@using CampaignTracker.Model.Creatures
@using Newtonsoft.Json

@inject HttpClient HttpClient

<MudDialog>
	<TitleContent>
		Import Enemies
	</TitleContent>
	<DialogContent>
		<MudStack Spacing="2">
			<MudTextField T="string"
						  @bind-Value="Filter"
						  Label="Filter creatures"
						  Variant="Variant.Outlined"
						  Margin="Margin.Dense"
						  Immediate="true"
						  Adornment="Adornment.Start"
						  AdornmentIcon="@Icons.Material.Filled.Search" />

			@if (_isLoading)
			{
				<MudProgressLinear Indeterminate="true" Color="Color.Primary" />
			}
			else if (!string.IsNullOrWhiteSpace(_loadError))
			{
				<MudAlert Severity="Severity.Error">@_loadError</MudAlert>
			}
			else
			{
				<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
					<MudText Typo="Typo.body2" Color="Color.Secondary">
						@_filteredCreatures.Count of @_creatures.Count creatures
					</MudText>
					<MudSpacer />
					<MudButton Variant="Variant.Text"
							   Color="Color.Primary"
							   Size="Size.Small"
							   Disabled="@(!_filteredCreatures.Any(CanImport))"
							   OnClick="SelectFilteredCreatures">
						Select Filtered
					</MudButton>
					<MudButton Variant="Variant.Text"
							   Color="Color.Default"
							   Size="Size.Small"
							   Disabled="@(_selectedCreatureGuids.Count == 0)"
							   OnClick="ClearSelection">
						Clear
					</MudButton>
				</MudStack>

				<MudStack Spacing="0" Class="creature-import-list">
					@if (_filteredCreatures.Count == 0)
					{
						<MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">No matching creatures</MudText>
					}
					else
					{
						<Virtualize Items="@_filteredCreatures" Context="creature" ItemSize="36" OverscanCount="8">
							<MudCheckBox T="bool"
										 Dense="true"
										 Label="@CreatureText(creature)"
										 Value="@(IsSelected(creature) || IsAlreadyImported(creature))"
										 Disabled="@IsAlreadyImported(creature)"
										 ValueChanged="@((bool selected) => SetSelected(creature, selected))" />
						</Virtualize>
					}
				</MudStack>
			}
		</MudStack>
	</DialogContent>
	<DialogActions>
		<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-auto">
			@_selectedCreatureGuids.Count selected
		</MudText>
		<MudButton OnClick="Cancel">Cancel</MudButton>
		<MudButton Color="Color.Primary"
				   Variant="Variant.Filled"
				   Disabled="@(_selectedCreatureGuids.Count == 0)"
				   OnClick="Confirm">
			Import Selected
		</MudButton>
	</DialogActions>
</MudDialog>

@code {
	private const string CreatureDataPath = "data/dnd5e/creatures.json";

	private readonly HashSet<Guid> _selectedCreatureGuids = [];
	private List<StaticCreature> _creatures = [];
	private List<StaticCreature> _filteredCreatures = [];
	private string _filter = string.Empty;
	private bool _isLoading = true;
	private string? _loadError;

	[CascadingParameter]
	private IMudDialogInstance MudDialog { get; set; } = null!;

	[Parameter]
	public IReadOnlyCollection<Guid> ExistingCreatureGuids { get; set; } = [];

	private string Filter
	{
		get => _filter;
		set
		{
			if (_filter == value)
			{
				return;
			}

			_filter = value;
			UpdateFilteredCreatures();
		}
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var json = await HttpClient.GetStringAsync(CreatureDataPath);
			_creatures = JsonConvert.DeserializeObject<List<StaticCreature>>(json) ?? [];
			UpdateFilteredCreatures();
		}
		catch (Exception ex)
		{
			_loadError = $"Could not load {CreatureDataPath}: {ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	private bool IsAlreadyImported(StaticCreature creature)
	{
		return ExistingCreatureGuids.Contains(creature.GUID);
	}

	private bool CanImport(StaticCreature creature)
	{
		return !IsAlreadyImported(creature);
	}

	private bool IsSelected(StaticCreature creature)
	{
		return _selectedCreatureGuids.Contains(creature.GUID);
	}

	private void SetSelected(StaticCreature creature, bool selected)
	{
		if (!CanImport(creature))
		{
			return;
		}

		if (selected)
		{
			_selectedCreatureGuids.Add(creature.GUID);
		}
		else
		{
			_selectedCreatureGuids.Remove(creature.GUID);
		}
	}

	private void SelectFilteredCreatures()
	{
		foreach (var creature in _filteredCreatures.Where(CanImport))
		{
			_selectedCreatureGuids.Add(creature.GUID);
		}
	}

	private void ClearSelection()
	{
		_selectedCreatureGuids.Clear();
	}

	private void Confirm()
	{
		var selectedCreatures = _creatures
			.Where(creature => _selectedCreatureGuids.Contains(creature.GUID))
			.OrderBy(creature => creature.DisplayName)
			.ToList();

		MudDialog.Close(DialogResult.Ok<IReadOnlyCollection<StaticCreature>>(selectedCreatures));
	}

	private void Cancel()
	{
		MudDialog.Cancel();
	}

	private void UpdateFilteredCreatures()
	{
		_filteredCreatures = _creatures
			.Where(creature => string.IsNullOrWhiteSpace(_filter) || CreatureText(creature).Contains(_filter, StringComparison.OrdinalIgnoreCase))
			.OrderBy(creature => creature.DisplayName)
			.ToList();
	}

	private static string CreatureText(StaticCreature creature)
	{
		return creature.ChallengeRating is null
			? creature.DisplayName
			: $"{creature.DisplayName} (CR {creature.ChallengeRating.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})";
	}
}
