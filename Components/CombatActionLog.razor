	{
		_damageTypeDialogOpen = true;
	}

	private void CloseDamageTypeDialog()
	{
		_damageTypeDialogOpen = false;
	}

	private void SelectDamageType(DamageType damageType)
	{
		_effectDraft.DamageType = damageType;
		_damageTypeDialogOpen = false;
	}

