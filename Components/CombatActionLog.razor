@using CampaignTracker.Model.Combats
@using CampaignTracker.Model.Creatures

@if (Combat == null)
{
	<MudText>No combat selected!</MudText>
}
else
{
	<MudStack Class="home-panel-scroll">

		@foreach (var entry in Combat.ActionLog.Entries)
		{
			List<Creature> actors = [];

			foreach (var actorGuid in entry.Actors)
				actors.Add(GetCreatureFromGUID(actorGuid));

			<MudStack Row AlignItems="AlignItems.Center">
				@foreach (var a in actors)
				{
					<MudChip T="string" Class="ma-0">
						<MudText Typo="Typo.body2">@a.Name</MudText>
					</MudChip>
				}
			
				<MudText>:</MudText>

				@foreach (var e in entry.Effects)
				{
					switch (e.Type)
					{
						case EffectType.Damage:
							var asDamageEntry = (ActionEffect_Damage)e;

							var groupedDamageInstances = asDamageEntry.DamageInstances
							.Select(x => (GetCreatureFromGUID(x.Target), (int)(x.BaseDamage * x.DamageMultiplier) /* TODO add damage resist/vuln */ , x))
							.GroupBy(x => x.Item2);

							<MudText>dealt</MudText>

							for (int i = 0; i < groupedDamageInstances.Count(); i++)
							{
								var group = groupedDamageInstances.ElementAt(i);
								<MudText>@group.First().Item2 damage to</MudText>

								foreach (var dmgInst in group)
								{
									<MudChip T="string" Class="ma-0">
										<MudText Typo="Typo.body2">@dmgInst.Item1.Name</MudText>
									</MudChip>
								}

								if(i == groupedDamageInstances.Count() - 2)
								{
									<MudText> and </MudText>
								}
								else if (i < groupedDamageInstances.Count() - 2)
								{
									<MudText>, </MudText>									
								}

							}
							break;
					}
				}
			</MudStack>
		}
	</MudStack>
}


@code {
	[Parameter]
	public Combat? Combat { get; set; }


	private Creature GetCreatureFromGUID(Guid guid)
	{
		if (Combat == null)
			return null;

		if (Combat.PlayerCharacterGUIDs.Contains(guid))
			return Combat.PlayerCharacters.First(x => x.GUID == guid);
		if (Combat.NpcGUIDs.Contains(guid))
			return Combat.Npcs.First(x => x.GUID == guid);
		if (Combat.EnemyGUIDs.Contains(guid))
			return Combat.Enemies.First(x => x.GUID == guid);
		
		return null;
	}

}
