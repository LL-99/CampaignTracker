	{
		await Changed.InvokeAsync();
	}

	private void AddActorsAsDefaultTargets(EffectType effectType)
	{
		if (effectType is not (EffectType.TemporaryHP or EffectType.Heal or EffectType.Buff))
		{
			return;
		}

		var targetableGuids = GetTargetableCreatures()
			.Select(creature => creature.GUID)
			.ToHashSet();

		_effectDraft.Targets.UnionWith(_selectedActorGuids.Where(targetableGuids.Contains));
	}

	private void ToggleSelected(Guid guid, HashSet<Guid> selectedGuids)
	{
		if (!selectedGuids.Add(guid))
		{
			selectedGuids.Remove(guid);
		}
	}

	private static void SelectAll(IEnumerable<Creature> creatures, HashSet<Guid> selectedGuids)
	{
		foreach (var creature in creatures)
		{
			selectedGuids.Add(creature.GUID);
		}
	}

	private static void ClearAll(IEnumerable<Creature> creatures, HashSet<Guid> selectedGuids)
	{
		foreach (var creature in creatures)
		{
			selectedGuids.Remove(creature.GUID);
		}
	}

	private IEnumerable<Creature> GetCreatures(IEnumerable<Guid> guids)
	{
		var guidSet = guids.ToHashSet();

		return AllCombatCreatures
			.Where(creature => guidSet.Contains(creature.GUID))
			.OrderBy(creature => creature.DisplayName);
	}

	private IEnumerable<Environmental> GetTargetableEnvironmentals()
	{
		return Combat?.Environmentals.Where(environmental => environmental.HP.HasValue) ?? [];
	}

	private IEnumerable<Creature> GetTargetableCreatures()
	{
		if (Combat is null)
		{
			return [];
		}

		return Combat.PlayerCharacters
			.Cast<Creature>()
			.Concat(Combat.Npcs)
			.Concat(Combat.Enemies)
			.Concat(GetTargetableEnvironmentals());
	}

	private IEnumerable<Creature> AllCombatCreatures
	{
		get
		{
			if (Combat is null)
			{
				return [];
			}

			return Combat.PlayerCharacters
				.Cast<Creature>()
				.Concat(Combat.Npcs)
				.Concat(Combat.Enemies)
				.Concat(Combat.Environmentals);
		}
	}

	private Creature? GetCreatureFromGuid(Guid guid)
	{
		return AllCombatCreatures.FirstOrDefault(creature => creature.GUID == guid);
	}

	private RenderFragment RenderEffectSummary(ActionEffect effect) => @<div class="action-log-effect-content">
		@switch (effect)
		{
			case ActionEffect_Damage damage:
				@RenderDamageSummary(damage)
				break;
			case ActionEffect_Condition condition:
				<span>applied @condition.Condition to</span>
				@RenderTargetChips(condition.Targets)
				@RenderEffectNote(condition.Description)
				break;
			case ActionEffect_TemporaryHP temporaryHp:
				<span>gave @FormatAmount(temporaryHp.TemporaryHPAmount) temporary HP to</span>
				@RenderTargetChips(temporaryHp.Targets)
				@RenderEffectNote(temporaryHp.Description)
				break;
			case ActionEffect_Heal heal:
				<span>healed @FormatAmount(heal.HealAmount) HP on</span>
				@RenderTargetChips(heal.Targets)
				@RenderEffectNote(heal.Description)
				break;
			case ActionEffect_Buff buff:
				<span>buffed</span>
				@RenderTargetChips(buff.Targets)
				@RenderEffectNote(buff.Description)
				break;
			default:
				<span>@(effect.Description ?? effect.Type.ToString())</span>
				break;
		}
	</div>;

	private RenderFragment RenderDamageSummary(ActionEffect_Damage damage) => @<div class="action-log-effect-lines">
		@{
			var groups = GetDamageSummaryGroups(damage);
		}
		@if (groups.Count == 0)
		{
			<span>dealt damage</span>
		}
		else
		{
			@foreach (var group in groups)
			{
				<div class="action-log-effect-line">
					<span>dealt</span>
					<span class="action-log-damage-text" style="@GetDamageTextStyle(group.DamageType)">
						@FormatAmount(group.ActualDamage) @FormatDamageType(group.DamageType) damage
					</span>
					<span>to</span>
					@RenderTargetChips(group.Targets)
				</div>
			}
		}
		@RenderEffectNote(GetDamageNote(damage))
	</div>;

	private static RenderFragment RenderEffectNote(string? note) => @<text>
		@if (!string.IsNullOrWhiteSpace(note))
		{
			<span class="action-log-effect-note">@note</span>
		}
	</text>;

	private RenderFragment RenderTargetChips(IEnumerable<Guid> targetGuids) => @<span class="action-log-target-chip-list">
		@{
			var targets = targetGuids
				.Select(guid => new
				{
					Name = GetCreatureFromGuid(guid)?.DisplayName ?? "Unknown creature"
				})
				.OrderBy(target => target.Name)
				.ToList();
		}
		@if (targets.Count == 0)
		{
			<span>no targets</span>
		}
		else
		{
			@foreach (var target in targets)
			{
				<MudChip T="string" Class="ma-0 action-log-target-chip" Size="Size.Small" Variant="Variant.Outlined">
					@target.Name
				</MudChip>
			}
		}
	</span>;

	private List<DamageSummaryGroup> GetDamageSummaryGroups(ActionEffect_Damage damage)
	{
		return damage.DamageInstances
			.Select(instance => new
			{
				instance.Target,
				ActualDamage = instance.BaseDamage * instance.DamageMultiplier,
				instance.DamageType
			})
			.GroupBy(instance => new { instance.ActualDamage, instance.DamageType })
			.Select(group => new DamageSummaryGroup(
				group.Key.ActualDamage,
				group.Key.DamageType,
				group
					.Select(instance => instance.Target)
					.OrderBy(TargetSortName)
					.ToList()))
			.OrderBy(group => group.DamageType)
			.ThenBy(group => group.ActualDamage)
			.ToList();
	}

	private string TargetSortName(Guid guid)
	{
		return GetCreatureFromGuid(guid)?.DisplayName ?? "Unknown creature";
	}

	private static string FormatAmount(float amount)
	{
		return Math.Abs(amount % 1) < 0.001f
			? ((int)amount).ToString()
			: amount.ToString("0.##");
	}

	private static string FormatDamageType(DamageType damageType)
	{
		return damageType.ToString().ToLowerInvariant();
	}

	private static string? GetDamageNote(ActionEffect_Damage damage)
	{
		return !string.IsNullOrWhiteSpace(damage.Description)
			? damage.Description
			: damage.DamageInstances.FirstOrDefault(instance => !string.IsNullOrWhiteSpace(instance.Note))?.Note;
	}

	private static string FormatDamageTypeLabel(DamageType damageType)
	{
		return damageType switch
		{
			DamageType.BludgeoningMagic => "Magic Bludgeoning",
			DamageType.PiercingMagic => "Magic Piercing",
			DamageType.SlashingMagic => "Magic Slashing",
			_ => damageType.ToString()
		};
	}

	private static string GetDamageTextStyle(DamageType damageType)
	{
		return $"color: {DamageTypeColors.GetColor(damageType)};";
	}

	private static string GetDamageTypeButtonStyle(DamageType damageType, bool selected)
	{
		var color = DamageTypeColors.GetColor(damageType);
		return selected
			? $"border-color: {color}; background-color: {color}; color: white;"
			: $"border-color: {color}; color: {color};";
