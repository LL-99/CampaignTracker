@using CampaignTracker.Model.Combats
@using CampaignTracker.Model.Creatures

@inject IDialogService DialogService

@if (Combat == null)
{
	<MudText>No combat selected!</MudText>
}
else
{
	<MudStack Class="combat-action-log">
		<MudStack Spacing="2" Class="combat-action-log-entries">
			@for (int i = 0; i < Combat.ActionLog.Entries.Count; i++)
			{
				var index = i;
				var entry = Combat.ActionLog.Entries[i];

				<div @key="entry"
					 class="@GetEntryClass(index)"
					 @ondragover:preventDefault="true"
					 @ondragenter="@(() => DragOverEntry(index))"
					 @ondrop="@(() => DropEntry(index))">
					<div class="action-log-entry-actors">
						@foreach (var actor in GetCreatures(entry.Actors))
						{
							<MudChip T="string" Class="ma-0 action-log-actor-chip" Size="Size.Small">
								@actor.DisplayName
							</MudChip>
						}
					</div>

					<div class="action-log-entry-effects">
						@foreach (var effect in entry.Effects)
						{
							<div class="action-log-entry-effect">
								@RenderEffectSummary(effect)
							</div>
						}
					</div>

					<MudStack Spacing="1" Class="action-log-entry-controls">
						<MudIconButton Icon="@Icons.Material.Filled.Edit"
									   Size="Size.Small"
									   aria-label="Edit entry"
									   OnClick="@(() => EditEntry(index))" />
						<MudIconButton Icon="@Icons.Material.Filled.DragIndicator"
									   Size="Size.Small"
									   aria-label="Move entry"
									   draggable="true"
									   @ondragstart="@(() => StartDraggingEntry(index))"
									   @ondragend="EndDraggingEntry" />
					</MudStack>
				</div>
			}

			@if (!Combat.ActionLog.Entries.Any())
			{
				<MudText Typo="Typo.body2" Color="Color.Secondary">No action log entries yet.</MudText>
			}
		</MudStack>

		<MudDivider />

		<MudStack Row="true" Class="combat-action-log-add-row">
			<MudButton Variant="Variant.Filled"
					   Color="Color.Primary"
					   StartIcon="@Icons.Material.Filled.Add"
					   OnClick="OpenPopup">
				Add Log Entry
			</MudButton>
			@if (HasWipEntry)
			{
				<MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
					Draft in progress
				</MudChip>
			}
		</MudStack>
	</MudStack>

	@if (_popupOpen)
	{
		<div class="action-log-popup-backdrop">
			<MudPaper Elevation="8" Class="action-log-popup pa-4">
				<MudStack Spacing="3" Class="action-log-popup-content">
					<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
						<MudText Typo="Typo.h6">@PopupTitle</MudText>
						<MudSpacer />
						<MudIconButton Icon="@Icons.Material.Filled.Close"
									   Size="Size.Small"
									   OnClick="ClosePopup" />
					</MudStack>

					<MudProgressLinear Color="Color.Success" Rounded="true" Size="Size.Large" Value="@PopupProgressValue" />

					<div class="action-log-popup-body">
						@switch (_page)
						{
							case ActionLogPopupPage.Actors:
								@RenderActorPage()
								break;
							case ActionLogPopupPage.EffectsOverview:
								@RenderEffectsOverviewPage()
								break;
							case ActionLogPopupPage.EffectType:
								@RenderEffectTypePage()
								break;
							case ActionLogPopupPage.Damage:
								@RenderDamagePage()
								break;
							case ActionLogPopupPage.Condition:
								@RenderConditionPage()
								break;
							case ActionLogPopupPage.TemporaryHP:
								@RenderTemporaryHpPage()
								break;
							case ActionLogPopupPage.Heal:
								@RenderHealPage()
								break;
							case ActionLogPopupPage.Buff:
								@RenderBuffPage()
								break;
						}
					</div>

					<MudDivider />

					<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="action-log-popup-footer">
						@if (_page == ActionLogPopupPage.EffectsOverview)
						{
							<MudButton Variant="Variant.Text"
									   Color="Color.Error"
									   StartIcon="@Icons.Material.Filled.Delete"
									   Disabled="@(!HasWipEntry)"
									   OnClick="DiscardButtonClicked">
								Discard
							</MudButton>
						}

						<MudSpacer />

						<MudButton Variant="Variant.Text"
								   Color="Color.Default"
								   OnClick="PreviousButtonClicked"
								   Disabled="@(!CanGoPrevious)">
							Previous
						</MudButton>

						@if (_page == ActionLogPopupPage.EffectsOverview)
						{
							<MudButton Variant="Variant.Outlined"
									   Color="Color.Primary"
									   StartIcon="@Icons.Material.Filled.Add"
									   OnClick="StartAddingEffect">
								Add Effect
							</MudButton>
							@if (_wipEffects.Count > 0)
							{
								<MudButton Variant="Variant.Filled"
										   Color="Color.Primary"
										   StartIcon="@Icons.Material.Filled.Save"
										   OnClick="SaveEntry">
									Save
								</MudButton>
							}
						}
						else if (IsEffectDetailPage)
						{
							<MudButton Variant="Variant.Filled"
									   Color="Color.Primary"
									   StartIcon="@Icons.Material.Filled.Check"
									   Disabled="@(!CanSaveDraftEffect)"
									   OnClick="SaveDraftEffect">
								@(_editingEffectIndex is null ? "Add" : "Update")
							</MudButton>
						}
						else
						{
							<MudButton Variant="Variant.Filled"
									   Color="Color.Primary"
									   OnClick="NextButtonClicked"
									   Disabled="@(!CanGoNext)">
								Next
							</MudButton>
						}
					</MudStack>
				</MudStack>
			</MudPaper>
		</div>
	}

	@if (_damageTypeDialogOpen)
	{
		<div class="action-log-damage-type-dialog-backdrop" @onclick="CloseDamageTypeDialog">
			<div class="action-log-damage-type-dialog-wrap" @onclick:stopPropagation="true">
				<MudPaper Elevation="10" Class="action-log-damage-type-dialog pa-4">
					<MudStack Spacing="3">
						<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
							<MudText Typo="Typo.h6">Damage Type</MudText>
							<MudSpacer />
							<MudIconButton Icon="@Icons.Material.Filled.Close"
										   Size="Size.Small"
										   OnClick="CloseDamageTypeDialog" />
						</MudStack>
						<div class="action-log-damage-type-grid">
							@foreach (var damageType in Enum.GetValues<DamageType>())
							{
								<MudButton Variant="@(_effectDraft.DamageType == damageType ? Variant.Filled : Variant.Outlined)"
										   Color="@(_effectDraft.DamageType == damageType ? Color.Primary : Color.Default)"
										   Size="Size.Small"
										   Style="@GetDamageTypeButtonStyle(damageType, _effectDraft.DamageType == damageType)"
										   OnClick="@(() => SelectDamageType(damageType))">
									@FormatDamageTypeLabel(damageType)
								</MudButton>
							}
						</div>
					</MudStack>
				</MudPaper>
			</div>
		</div>
	}
}

@code {
	[Parameter]
	public Combat? Combat { get; set; }

	private Guid? _activeCombatGuid;
	private bool _popupOpen;
	private ActionLogPopupPage _page = ActionLogPopupPage.Actors;
	private readonly HashSet<Guid> _selectedActorGuids = [];
	private readonly List<ActionEffect> _wipEffects = [];
	private EffectDraft _effectDraft = new();
	private int? _editingEntryIndex;
	private int? _editingEffectIndex;
	private int? _draggedEntryIndex;
	private int? _dragOverEntryIndex;
	private bool _damageTypeDialogOpen;

	private bool HasWipEntry => _selectedActorGuids.Count > 0 || _wipEffects.Count > 0 || _editingEntryIndex is not null || _editingEffectIndex is not null;

	private bool IsEffectDetailPage => _page is ActionLogPopupPage.Damage
		or ActionLogPopupPage.Condition
		or ActionLogPopupPage.TemporaryHP
		or ActionLogPopupPage.Heal
		or ActionLogPopupPage.Buff;

	private bool CanGoPrevious => _page != ActionLogPopupPage.Actors;

	private bool CanGoNext => _page switch
	{
		ActionLogPopupPage.Actors => _selectedActorGuids.Count > 0,
		ActionLogPopupPage.EffectType => true,
		_ => false
	};

	private bool CanSaveDraftEffect => _effectDraft.Targets.Count > 0
		&& (_page switch
		{
			ActionLogPopupPage.Damage => _effectDraft.Amount > 0,
			ActionLogPopupPage.Heal => _effectDraft.Amount > 0,
			ActionLogPopupPage.TemporaryHP => _effectDraft.Amount > 0,
			ActionLogPopupPage.Condition => true,
			ActionLogPopupPage.Buff => true,
			_ => false
		});

	private string PopupTitle => _page switch
	{
		ActionLogPopupPage.Actors => "Actors",
		ActionLogPopupPage.EffectsOverview => _editingEntryIndex is null ? "Effects" : "Edit Effects",
		ActionLogPopupPage.EffectType => "Effect Type",
		ActionLogPopupPage.Damage => "Damage",
		ActionLogPopupPage.Condition => "Condition",
		ActionLogPopupPage.TemporaryHP => "Temporary HP",
		ActionLogPopupPage.Heal => "Heal",
		ActionLogPopupPage.Buff => "Buff",
		_ => "Action Log Entry"
	};

	private int PopupProgressValue => _page switch
	{
		ActionLogPopupPage.Actors => 25,
		ActionLogPopupPage.EffectsOverview => 50,
		ActionLogPopupPage.EffectType => 75,
		_ => 100
	};

	protected override void OnParametersSet()
	{
		if (Combat?.GUID == _activeCombatGuid)
		{
			return;
		}

		_activeCombatGuid = Combat?.GUID;
		ResetWipEntry();
		_popupOpen = false;
		_page = ActionLogPopupPage.Actors;
	}

	private RenderFragment RenderActorPage() => @<MudStack Spacing="3">
		<MudText Typo="Typo.body2" Color="Color.Secondary">
			Choose every actor that acted. Buttons stay selected until you change combat or discard the draft.
		</MudText>
		@RenderCreatureButtonGroup("Players", Combat?.PlayerCharacters ?? [], _selectedActorGuids)
		@RenderCreatureButtonGroup("NPCs", Combat?.Npcs ?? [], _selectedActorGuids)
		@RenderCreatureButtonGroup("Enemies", Combat?.Enemies ?? [], _selectedActorGuids)
		@RenderCreatureButtonGroup("Environmentals", Combat?.Environmentals ?? [], _selectedActorGuids)
	</MudStack>;

	private RenderFragment RenderEffectsOverviewPage() => @<MudStack Spacing="2">
		<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
			<MudText Typo="Typo.subtitle2">Actors</MudText>
			@foreach (var actor in GetCreatures(_selectedActorGuids))
			{
				<MudChip T="string" Size="Size.Small" Class="ma-0">@actor.DisplayName</MudChip>
			}
		</MudStack>

		@if (_wipEffects.Count == 0)
		{
			<MudText Typo="Typo.body2" Color="Color.Secondary">
				Add at least one effect to enable Save.
			</MudText>
		}
		else
		{
			@for (int i = 0; i < _wipEffects.Count; i++)
			{
				var index = i;
				var effect = _wipEffects[i];

				<MudPaper Outlined="true" Class="action-log-effect-row pa-2">
					<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
						<div class="action-log-effect-summary">
							@RenderEffectSummary(effect)
						</div>
						<MudSpacer />
						<MudIconButton Icon="@Icons.Material.Filled.Edit"
									   Size="Size.Small"
									   OnClick="@(() => EditEffect(index))" />
						<MudIconButton Icon="@Icons.Material.Filled.Delete"
									   Size="Size.Small"
									   Color="Color.Error"
									   OnClick="@(() => RemoveEffect(index))" />
					</MudStack>
				</MudPaper>
			}
		}
	</MudStack>;

	private RenderFragment RenderEffectTypePage() => @<MudGrid Spacing="2">
		@foreach (var effectType in Enum.GetValues<EffectType>())
		{
			<MudItem xs="6" sm="4">
				<MudButton Variant="@(_effectDraft.Type == effectType ? Variant.Filled : Variant.Outlined)"
						   Color="@(_effectDraft.Type == effectType ? Color.Primary : Color.Default)"
						   FullWidth="true"
						   Class="action-log-type-button"
						   OnClick="@(() => SelectEffectType(effectType, true))">
					@FormatEffectType(effectType)
				</MudButton>
			</MudItem>
		}
	</MudGrid>;

	private RenderFragment RenderDamagePage() => @<MudStack Spacing="3">
		<MudGrid Spacing="2">
			<MudItem xs="6" sm="4">
				<MudNumericField T="float"
								 @bind-Value="_effectDraft.Amount"
								 Label="Damage"
								 Min="0"
								 Variant="Variant.Outlined"
								 Margin="Margin.Dense"
								 Immediate="true" />
			</MudItem>
			<MudItem xs="6" sm="4">
				<MudStack Spacing="1">
					<MudText Typo="Typo.caption" Color="Color.Secondary">Type</MudText>
					<MudButton Variant="Variant.Outlined"
							   Color="Color.Default"
							   FullWidth="true"
							   Class="action-log-damage-type-button"
							   Style="@GetDamageTypeButtonStyle(_effectDraft.DamageType, false)"
							   OnClick="OpenDamageTypeDialog">
						@FormatDamageTypeLabel(_effectDraft.DamageType)
					</MudButton>
				</MudStack>
			</MudItem>
			<MudItem xs="12" sm="4">
				<MudStack Row="true" Spacing="1" Class="action-log-multiplier-buttons">
					@RenderMultiplierButton("Half", 0.5f)
					@RenderMultiplierButton("Normal", 1f)
					@RenderMultiplierButton("Double", 2f)
				</MudStack>
			</MudItem>
		</MudGrid>
		@RenderTargetPicker()
	</MudStack>;

	private RenderFragment RenderConditionPage() => @<MudStack Spacing="3">
		<MudText Typo="Typo.subtitle2">Condition</MudText>
		<div class="action-log-choice-grid">
			@foreach (var condition in Enum.GetValues<Condition>())
			{
				<MudButton Variant="@(_effectDraft.Condition == condition ? Variant.Filled : Variant.Outlined)"
						   Color="@(_effectDraft.Condition == condition ? Color.Primary : Color.Default)"
						   Size="Size.Small"
						   OnClick="@(() => _effectDraft.Condition = condition)">
					@condition
				</MudButton>
			}
		</div>
		@RenderTargetPicker()
	</MudStack>;

	private RenderFragment RenderTemporaryHpPage() => @<MudStack Spacing="3">
		<MudNumericField T="float"
						 @bind-Value="_effectDraft.Amount"
						 Label="Temporary HP"
						 Min="0"
						 Variant="Variant.Outlined"
						 Margin="Margin.Dense"
						 Immediate="true"
						 Class="action-log-amount-input" />
		@RenderTargetPicker()
	</MudStack>;

	private RenderFragment RenderHealPage() => @<MudStack Spacing="3">
		<MudNumericField T="float"
						 @bind-Value="_effectDraft.Amount"
						 Label="Heal"
						 Min="0"
						 Variant="Variant.Outlined"
						 Margin="Margin.Dense"
						 Immediate="true"
						 Class="action-log-amount-input" />
		@RenderTargetPicker()
	</MudStack>;

	private RenderFragment RenderBuffPage() => @<MudStack Spacing="3">
		<MudTextField T="string"
					  @bind-Value="_effectDraft.Description"
					  Label="Buff note"
					  Variant="Variant.Outlined"
					  Margin="Margin.Dense"
					  Immediate="true" />
		@RenderTargetPicker()
	</MudStack>;

	private RenderFragment RenderTargetPicker() => @<MudStack Spacing="3">
		<MudText Typo="Typo.subtitle2">Targets</MudText>
		@RenderCreatureButtonGroup("Players", Combat?.PlayerCharacters ?? [], _effectDraft.Targets)
		@RenderCreatureButtonGroup("NPCs", Combat?.Npcs ?? [], _effectDraft.Targets)
		@RenderCreatureButtonGroup("Enemies", Combat?.Enemies ?? [], _effectDraft.Targets)
		@RenderCreatureButtonGroup("Environmentals", Combat?.Environmentals ?? [], _effectDraft.Targets)
	</MudStack>;

	private RenderFragment RenderCreatureButtonGroup(string title, IReadOnlyCollection<Creature> creatures, HashSet<Guid> selectedGuids) => @<MudStack Spacing="1">
		<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
			<MudText Typo="Typo.subtitle2">@title</MudText>
			@if (creatures.Count > 1)
			{
				<MudButton Variant="Variant.Text"
						   Color="Color.Primary"
						   Size="Size.Small"
						   OnClick="@(() => SelectAll(creatures, selectedGuids))">
					All
				</MudButton>
				<MudButton Variant="Variant.Text"
						   Color="Color.Default"
						   Size="Size.Small"
						   OnClick="@(() => ClearAll(creatures, selectedGuids))">
					None
				</MudButton>
			}
		</MudStack>
		@if (creatures.Count == 0)
		{
			<MudText Typo="Typo.body2" Color="Color.Secondary">No @title.ToLowerInvariant()</MudText>
		}
		else
		{
			<div class="action-log-creature-buttons">
				@foreach (var creature in creatures.OrderBy(creature => creature.DisplayName))
				{
					var selected = selectedGuids.Contains(creature.GUID);
					<MudButton Variant="@(selected ? Variant.Filled : Variant.Outlined)"
							   Color="@(selected ? Color.Primary : Color.Default)"
							   Size="Size.Small"
							   OnClick="@(() => ToggleSelected(creature.GUID, selectedGuids))">
						@creature.DisplayName
					</MudButton>
				}
			</div>
		}
	</MudStack>;

	private RenderFragment RenderMultiplierButton(string label, float multiplier) => @<MudButton Variant="@(Math.Abs(_effectDraft.DamageMultiplier - multiplier) < 0.001f ? Variant.Filled : Variant.Outlined)"
																							  Color="@(Math.Abs(_effectDraft.DamageMultiplier - multiplier) < 0.001f ? Color.Primary : Color.Default)"
																							  Size="Size.Small"
																							  OnClick="@(() => _effectDraft.DamageMultiplier = multiplier)">
		@label
	</MudButton>;

	private void OpenPopup()
	{
		_popupOpen = true;
	}

	private void ClosePopup()
	{
		_popupOpen = false;
		_damageTypeDialogOpen = false;
	}

	private void PreviousButtonClicked()
	{
		if (IsEffectDetailPage)
		{
			_page = ActionLogPopupPage.EffectType;
			return;
		}

		_page = _page switch
		{
			ActionLogPopupPage.EffectsOverview => ActionLogPopupPage.Actors,
			ActionLogPopupPage.EffectType => _wipEffects.Count == 0 && _editingEffectIndex is null
				? ActionLogPopupPage.Actors
				: ActionLogPopupPage.EffectsOverview,
			_ => _page
		};
	}

	private void NextButtonClicked()
	{
		_page = _page switch
		{
			ActionLogPopupPage.Actors => _wipEffects.Count == 0
				? ActionLogPopupPage.EffectType
				: ActionLogPopupPage.EffectsOverview,
			ActionLogPopupPage.EffectType => GetDetailPage(_effectDraft.Type),
			_ => _page
		};
	}

	private void StartAddingEffect()
	{
		_editingEffectIndex = null;
		_effectDraft = new EffectDraft();
		_page = ActionLogPopupPage.EffectType;
	}

	private void SelectEffectType(EffectType effectType, bool advance)
	{
		_effectDraft.Type = effectType;

		if (advance)
		{
			_page = GetDetailPage(effectType);
		}
	}

	private void EditEffect(int index)
	{
		if (index < 0 || index >= _wipEffects.Count)
		{
			return;
		}

		_editingEffectIndex = index;
		_effectDraft = EffectDraft.FromEffect(_wipEffects[index]);
		_page = GetDetailPage(_effectDraft.Type);
	}

	private void EditEntry(int index)
	{
		if (Combat is null || index < 0 || index >= Combat.ActionLog.Entries.Count)
		{
			return;
		}

		var entry = Combat.ActionLog.Entries[index];

		ResetWipEntry();
		_editingEntryIndex = index;
		_selectedActorGuids.UnionWith(entry.Actors);
		_wipEffects.AddRange(entry.Effects);
		_page = ActionLogPopupPage.EffectsOverview;
		_popupOpen = true;
	}

	private void RemoveEffect(int index)
	{
		if (index >= 0 && index < _wipEffects.Count)
		{
			_wipEffects.RemoveAt(index);
		}
	}

	private void SaveDraftEffect()
	{
		if (!CanSaveDraftEffect)
		{
			return;
		}

		var effect = _effectDraft.ToEffect();

		if (_editingEffectIndex is int index && index >= 0 && index < _wipEffects.Count)
		{
			_wipEffects[index] = effect;
		}
		else
		{
			_wipEffects.Add(effect);
		}

		_editingEffectIndex = null;
		_effectDraft = new EffectDraft();
		_page = ActionLogPopupPage.EffectsOverview;
	}

	private void SaveEntry()
	{
		if (Combat is null || _wipEffects.Count == 0 || _selectedActorGuids.Count == 0)
		{
			return;
		}

		if (_editingEntryIndex is int index && index >= 0 && index < Combat.ActionLog.Entries.Count)
		{
			var entry = Combat.ActionLog.Entries[index];
			entry.Actors = _selectedActorGuids.ToArray();
			entry.Effects = _wipEffects.ToArray();
		}
		else
		{
			Combat.ActionLog.AddEntry(Combat.GUID, _selectedActorGuids, _wipEffects.ToArray());
		}

		ResetWipEntry();
		_popupOpen = false;
		_page = ActionLogPopupPage.Actors;
	}

	private async Task DiscardButtonClicked()
	{
		if (!HasWipEntry)
		{
			return;
		}

		var shouldDiscard = await DialogService.ShowMessageBoxAsync(
			"Discard draft?",
			"This clears the actors and all effects in the current action log draft.",
			yesText: "Discard",
			cancelText: "Cancel");

		if (shouldDiscard == true)
		{
			ResetWipEntry();
			_page = ActionLogPopupPage.Actors;
		}
	}

	private void ResetWipEntry()
	{
		_selectedActorGuids.Clear();
		_wipEffects.Clear();
		_effectDraft = new EffectDraft();
		_editingEntryIndex = null;
		_editingEffectIndex = null;
		_damageTypeDialogOpen = false;
	}

	private void StartDraggingEntry(int index)
	{
		_draggedEntryIndex = index;
		_dragOverEntryIndex = index;
	}

	private void DragOverEntry(int index)
	{
		if (_draggedEntryIndex is not null)
		{
			_dragOverEntryIndex = index;
		}
	}

	private void DropEntry(int targetIndex)
	{
		if (Combat is null || _draggedEntryIndex is not int sourceIndex)
		{
			EndDraggingEntry();
			return;
		}

		var entries = Combat.ActionLog.Entries;
		if (sourceIndex < 0 || sourceIndex >= entries.Count || targetIndex < 0 || targetIndex >= entries.Count || sourceIndex == targetIndex)
		{
			EndDraggingEntry();
			return;
		}

		var entry = entries[sourceIndex];
		entries.RemoveAt(sourceIndex);
		entries.Insert(targetIndex, entry);
		EndDraggingEntry();
	}

	private void EndDraggingEntry()
	{
		_draggedEntryIndex = null;
		_dragOverEntryIndex = null;
	}

	private void OpenDamageTypeDialog()
	{
		_damageTypeDialogOpen = true;
	}

	private void CloseDamageTypeDialog()
	{
		_damageTypeDialogOpen = false;
	}

	private void SelectDamageType(DamageType damageType)
	{
		_effectDraft.DamageType = damageType;
		_damageTypeDialogOpen = false;
	}

	private void ToggleSelected(Guid guid, HashSet<Guid> selectedGuids)
	{
		if (!selectedGuids.Add(guid))
		{
			selectedGuids.Remove(guid);
		}
	}

	private static void SelectAll(IEnumerable<Creature> creatures, HashSet<Guid> selectedGuids)
	{
		foreach (var creature in creatures)
		{
			selectedGuids.Add(creature.GUID);
		}
	}

	private static void ClearAll(IEnumerable<Creature> creatures, HashSet<Guid> selectedGuids)
	{
		foreach (var creature in creatures)
		{
			selectedGuids.Remove(creature.GUID);
		}
	}

	private IEnumerable<Creature> GetCreatures(IEnumerable<Guid> guids)
	{
		var guidSet = guids.ToHashSet();

		return AllCombatCreatures
			.Where(creature => guidSet.Contains(creature.GUID))
			.OrderBy(creature => creature.DisplayName);
	}

	private IEnumerable<Creature> AllCombatCreatures
	{
		get
		{
			if (Combat is null)
			{
				return [];
			}

			return Combat.PlayerCharacters
				.Cast<Creature>()
				.Concat(Combat.Npcs)
				.Concat(Combat.Enemies)
				.Concat(Combat.Environmentals);
		}
	}

	private Creature? GetCreatureFromGuid(Guid guid)
	{
		return AllCombatCreatures.FirstOrDefault(creature => creature.GUID == guid);
	}

	private RenderFragment RenderEffectSummary(ActionEffect effect) => @<div class="action-log-effect-content">
		@switch (effect)
		{
			case ActionEffect_Damage damage:
				@RenderDamageSummary(damage)
				break;
			case ActionEffect_Condition condition:
				<span>applied @condition.Condition to</span>
				@RenderTargetChips(condition.Targets)
				break;
			case ActionEffect_TemporaryHP temporaryHp:
				<span>gave @FormatAmount(temporaryHp.TemporaryHPAmount) temporary HP to</span>
				@RenderTargetChips(temporaryHp.Targets)
				break;
			case ActionEffect_Heal heal:
				<span>healed @FormatAmount(heal.HealAmount) HP on</span>
				@RenderTargetChips(heal.Targets)
				break;
			case ActionEffect_Buff buff:
				<span>buffed</span>
				@RenderTargetChips(buff.Targets)
				@if (!string.IsNullOrWhiteSpace(buff.Description))
				{
					<span class="action-log-effect-note">@buff.Description</span>
				}
				break;
			default:
				<span>@(effect.Description ?? effect.Type.ToString())</span>
				break;
		}
	</div>;

	private RenderFragment RenderDamageSummary(ActionEffect_Damage damage) => @<div class="action-log-effect-lines">
		@{
			var groups = GetDamageSummaryGroups(damage);
		}
		@if (groups.Count == 0)
		{
			<span>dealt damage</span>
		}
		else
		{
			@foreach (var group in groups)
			{
				<div class="action-log-effect-line">
					<span>dealt</span>
					<span class="action-log-damage-text" style="@GetDamageTextStyle(group.DamageType)">
						@FormatAmount(group.ActualDamage) @FormatDamageType(group.DamageType) damage
					</span>
					<span>to</span>
					@RenderTargetChips(group.Targets)
				</div>
			}
		}
	</div>;

	private RenderFragment RenderTargetChips(IEnumerable<Guid> targetGuids) => @<span class="action-log-target-chip-list">
		@{
			var targets = targetGuids
				.Select(guid => new
				{
					Name = GetCreatureFromGuid(guid)?.DisplayName ?? "Unknown creature"
				})
				.OrderBy(target => target.Name)
				.ToList();
		}
		@if (targets.Count == 0)
		{
			<span>no targets</span>
		}
		else
		{
			@foreach (var target in targets)
			{
				<MudChip T="string" Class="ma-0 action-log-target-chip" Size="Size.Small" Variant="Variant.Outlined">
					@target.Name
				</MudChip>
			}
		}
	</span>;

	private List<DamageSummaryGroup> GetDamageSummaryGroups(ActionEffect_Damage damage)
	{
		return damage.DamageInstances
			.Select(instance => new
			{
				instance.Target,
				ActualDamage = instance.BaseDamage * instance.DamageMultiplier,
				instance.DamageType
			})
			.GroupBy(instance => new { instance.ActualDamage, instance.DamageType })
			.Select(group => new DamageSummaryGroup(
				group.Key.ActualDamage,
				group.Key.DamageType,
				group
					.Select(instance => instance.Target)
					.OrderBy(TargetSortName)
					.ToList()))
			.OrderBy(group => group.DamageType)
			.ThenBy(group => group.ActualDamage)
			.ToList();
	}

	private string TargetSortName(Guid guid)
	{
		return GetCreatureFromGuid(guid)?.DisplayName ?? "Unknown creature";
	}

	private static string FormatAmount(float amount)
	{
		return Math.Abs(amount % 1) < 0.001f
			? ((int)amount).ToString()
			: amount.ToString("0.##");
	}

	private static string FormatDamageType(DamageType damageType)
	{
		return damageType.ToString().ToLowerInvariant();
	}

	private static string FormatDamageTypeLabel(DamageType damageType)
	{
		return damageType switch
		{
			DamageType.BludgeoningMagic => "Magic Bludgeoning",
			DamageType.PiercingMagic => "Magic Piercing",
			DamageType.SlashingMagic => "Magic Slashing",
			_ => damageType.ToString()
		};
	}

	private static string GetDamageTextStyle(DamageType damageType)
	{
		return $"color: {DamageTypeColors.GetColor(damageType)};";
	}

	private static string GetDamageTypeButtonStyle(DamageType damageType, bool selected)
	{
		var color = DamageTypeColors.GetColor(damageType);
		return selected
			? $"border-color: {color}; background-color: {color}; color: white;"
			: $"border-color: {color}; color: {color};";
	}

	private string GetEntryClass(int index)
	{
		var classes = "combat-action-log-entry";

		if (_draggedEntryIndex == index)
		{
			classes += " is-dragging";
		}

		if (_dragOverEntryIndex == index && _draggedEntryIndex != index)
		{
			classes += " is-drag-over";
		}

		return classes;
	}

	private static string FormatEffectType(EffectType effectType)
	{
		return effectType == EffectType.TemporaryHP
			? "Temporary HP"
			: effectType.ToString();
	}

	private static ActionLogPopupPage GetDetailPage(EffectType effectType)
	{
		return effectType switch
		{
			EffectType.Damage => ActionLogPopupPage.Damage,
			EffectType.Condition => ActionLogPopupPage.Condition,
			EffectType.TemporaryHP => ActionLogPopupPage.TemporaryHP,
			EffectType.Heal => ActionLogPopupPage.Heal,
			EffectType.Buff => ActionLogPopupPage.Buff,
			_ => ActionLogPopupPage.EffectType
		};
	}

	private enum ActionLogPopupPage
	{
		Actors,
		EffectsOverview,
		EffectType,
		Damage,
		Condition,
		TemporaryHP,
		Heal,
		Buff
	}

	private sealed record DamageSummaryGroup(float ActualDamage, DamageType DamageType, IReadOnlyList<Guid> Targets);

	private sealed class EffectDraft
	{
		public EffectType Type { get; set; } = EffectType.Damage;
		public HashSet<Guid> Targets { get; set; } = [];
		public float Amount { get; set; } = 1;
		public DamageType DamageType { get; set; } = DamageType.Slashing;
		public float DamageMultiplier { get; set; } = 1;
		public Condition Condition { get; set; } = Condition.Prone;
		public string? Description { get; set; }

		public static EffectDraft FromEffect(ActionEffect effect)
		{
			var draft = new EffectDraft
			{
				Type = effect.Type,
				Description = effect.Description
			};

			switch (effect)
			{
				case ActionEffect_Damage damage:
					var firstDamageInstance = damage.DamageInstances.FirstOrDefault();
					draft.Targets = damage.DamageInstances.Select(instance => instance.Target).ToHashSet();
					draft.Amount = firstDamageInstance?.BaseDamage ?? 1;
					draft.DamageType = firstDamageInstance?.DamageType ?? DamageType.Slashing;
					draft.DamageMultiplier = firstDamageInstance?.DamageMultiplier ?? 1;
					break;
				case ActionEffect_Condition condition:
					draft.Condition = condition.Condition;
					draft.Targets = condition.Targets.ToHashSet();
					break;
				case ActionEffect_TemporaryHP temporaryHp:
					draft.Amount = temporaryHp.TemporaryHPAmount;
					draft.Targets = temporaryHp.Targets.ToHashSet();
					break;
				case ActionEffect_Heal heal:
					draft.Amount = heal.HealAmount;
					draft.Targets = heal.Targets.ToHashSet();
					break;
				case ActionEffect_Buff buff:
					draft.Targets = buff.Targets.ToHashSet();
					break;
			}

			return draft;
		}

		public ActionEffect ToEffect()
		{
			return Type switch
			{
				EffectType.Damage => new ActionEffect_Damage
				{
					Type = EffectType.Damage,
					Description = Description,
					DamageInstances = Targets
						.Select(target => new ActionEffect_DamageEntry
						{
							Target = target,
							BaseDamage = Amount,
							DamageType = DamageType,
							DamageMultiplier = DamageMultiplier
						})
						.ToArray()
				},
				EffectType.Condition => new ActionEffect_Condition
				{
					Type = EffectType.Condition,
					Description = Description,
					Condition = Condition,
					Targets = Targets.ToArray()
				},
				EffectType.TemporaryHP => new ActionEffect_TemporaryHP
				{
					Type = EffectType.TemporaryHP,
					Description = Description,
					TemporaryHPAmount = Amount,
					Targets = Targets.ToArray()
				},
				EffectType.Heal => new ActionEffect_Heal
				{
					Type = EffectType.Heal,
					Description = Description,
					HealAmount = Amount,
					Targets = Targets.ToArray()
				},
				EffectType.Buff => new ActionEffect_Buff
				{
					Type = EffectType.Buff,
					Description = Description,
					Targets = Targets.ToArray()
				},
				_ => new ActionEffect
				{
					Type = Type,
					Description = Description
				}
			};
		}
	}
}
