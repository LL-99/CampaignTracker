	private bool ShouldRenderTurnDivider(int index)
	{
		if (Combat is null || index < 0 || index >= Combat.ActionLog.Entries.Count)
		{
			return false;
		}

		return index == 0
			|| GetEntryTurn(Combat.ActionLog.Entries[index]) != GetEntryTurn(Combat.ActionLog.Entries[index - 1]);
	}

	private static int GetEntryTurn(ActionLogEntry entry)
	{
		return Math.Max(1, entry.Turn);
	}

	private int GetEntryInsertionTargetIndex(int targetIndex)
	{
		if (Combat is null || targetIndex != Combat.ActionLog.Entries.Count - 1)
		{
			return targetIndex;
		}

		return targetIndex + 1;
	}

	private int GetInheritedTurnForEntryDrop(int targetIndex)
	{
		if (Combat is null)
		{
			return 1;
		}

		var entries = Combat.ActionLog.Entries;
		var sourceIndex = _draggedEntryIndex;
		var entriesWithoutDragged = entries
			.Where((_, index) => sourceIndex is null || index != sourceIndex)
			.ToList();

		if (sourceIndex is int source && source < targetIndex)
		{
			targetIndex--;
		}

		targetIndex = Math.Clamp(targetIndex, 0, entriesWithoutDragged.Count);

		if (targetIndex > 0)
		{
			return GetEntryTurn(entriesWithoutDragged[targetIndex - 1]);
		}

		if (entriesWithoutDragged.Count > 0)
		{
			return GetEntryTurn(entriesWithoutDragged[0]);
		}

		return Math.Max(1, Combat.ActionLog.CurrentTurn);
	}

	private int GetNewTurnIndex()
	{
		return GetLastTurnIndex() + 1;
	}

	private int GetLastTurnIndex()
	{
		if (Combat is null)
		{
			return 1;
		}

		return Math.Max(1, Combat.ActionLog.Entries.LastOrDefault()?.Turn ?? Combat.ActionLog.CurrentTurn);
	}

	private string GetTurnDividerClass(int index)
	{
		var classes = "action-log-turn-divider";

		if (_dragOverTurnDividerIndex == index)
		{
			classes += " is-drag-over";
		}

		return classes;
	}

	private string GetNewTurnDividerClass()
	{
		var classes = "action-log-turn-divider action-log-new-turn-divider";

		if (_dragOverNewTurnDivider)
		{
			classes += " is-drag-over";
		}

		return classes;
	}

	private string GetEntryClass(int index)
	{
		var classes = "combat-action-log-entry";

		if (_draggedEntryIndex == index)
		{
			classes += " is-dragging";
		}

		if (_dragOverEntryIndex == index && _draggedEntryIndex != index)
		{
			classes += " is-drag-over";
		}

		return classes;
	}

	private static string FormatEffectType(EffectType effectType)
	{
		return effectType == EffectType.TemporaryHP
			? "Temporary HP"
			: effectType.ToString();
	}

	private static ActionLogPopupPage GetDetailPage(EffectType effectType)
	{
		return effectType switch
		{
			EffectType.Damage => ActionLogPopupPage.Damage,
			EffectType.Condition => ActionLogPopupPage.Condition,
			EffectType.TemporaryHP => ActionLogPopupPage.TemporaryHP,
			EffectType.Heal => ActionLogPopupPage.Heal,
			EffectType.Buff => ActionLogPopupPage.Buff,
			_ => ActionLogPopupPage.EffectType
		};
	}

	private static ActionEffect CloneEffect(ActionEffect effect)
	{
		return effect switch
		{
			ActionEffect_Damage damage => new ActionEffect_Damage
			{
				Type = EffectType.Damage,
				Description = damage.Description,
				DamageInstances = damage.DamageInstances
					.Select(instance => new ActionEffect_DamageEntry
					{
						Target = instance.Target,
						DamageType = instance.DamageType,
						BaseDamage = instance.BaseDamage,
						DamageMultiplier = instance.DamageMultiplier,
						Note = instance.Note
					})
					.ToArray()
			},
			ActionEffect_Condition condition => new ActionEffect_Condition
			{
				Type = EffectType.Condition,
				Description = condition.Description,
				Condition = condition.Condition,
				Targets = condition.Targets.ToArray()
			},
			ActionEffect_TemporaryHP temporaryHp => new ActionEffect_TemporaryHP
			{
				Type = EffectType.TemporaryHP,
				Description = temporaryHp.Description,
				TemporaryHPAmount = temporaryHp.TemporaryHPAmount,
				Targets = temporaryHp.Targets.ToArray()
			},
			ActionEffect_Heal heal => new ActionEffect_Heal
			{
				Type = EffectType.Heal,
				Description = heal.Description,
				HealAmount = heal.HealAmount,
				Targets = heal.Targets.ToArray()
			},
			ActionEffect_Buff buff => new ActionEffect_Buff
			{
				Type = EffectType.Buff,
				Description = buff.Description,
				Targets = buff.Targets.ToArray()
			},
			_ => new ActionEffect
			{
				Type = effect.Type,
				Description = effect.Description
			}
		};
	}

	private enum ActionLogPopupPage
	{
		Actors,
		EffectsOverview,
		EffectType,
		Damage,
		Condition,
		TemporaryHP,
		Heal,
		Buff
	}

	private sealed record DamageSummaryGroup(float ActualDamage, DamageType DamageType, IReadOnlyList<Guid> Targets);
	private sealed record EntryEditSnapshot(string ActorsKey, string EffectsJson);

	private sealed class EffectDraft
	{
		public EffectType Type { get; set; } = EffectType.Damage;
		public HashSet<Guid> Targets { get; set; } = [];
		public float Amount { get; set; } = 1;
		public DamageType DamageType { get; set; } = DamageType.Slashing;
		public float DamageMultiplier { get; set; } = 1;
		public Condition Condition { get; set; } = Condition.Prone;
		public string? Description { get; set; }

		public static EffectDraft FromEffect(ActionEffect effect)
		{
			var draft = new EffectDraft
			{
				Type = effect.Type,
				Description = effect.Description
			};

			switch (effect)
			{
				case ActionEffect_Damage damage:
					var firstDamageInstance = damage.DamageInstances.FirstOrDefault();
					draft.Targets = damage.DamageInstances.Select(instance => instance.Target).ToHashSet();
					draft.Amount = firstDamageInstance?.BaseDamage ?? 1;
					draft.DamageType = firstDamageInstance?.DamageType ?? DamageType.Slashing;
					draft.DamageMultiplier = firstDamageInstance?.DamageMultiplier ?? 1;
					draft.Description = !string.IsNullOrWhiteSpace(damage.Description)
						? damage.Description
						: firstDamageInstance?.Note;
					break;
				case ActionEffect_Condition condition:
					draft.Condition = condition.Condition;
					draft.Targets = condition.Targets.ToHashSet();
					break;
				case ActionEffect_TemporaryHP temporaryHp:
					draft.Amount = temporaryHp.TemporaryHPAmount;
					draft.Targets = temporaryHp.Targets.ToHashSet();
					break;
				case ActionEffect_Heal heal:
					draft.Amount = heal.HealAmount;
					draft.Targets = heal.Targets.ToHashSet();
					break;
				case ActionEffect_Buff buff:
					draft.Targets = buff.Targets.ToHashSet();
					break;
			}

			return draft;
		}

		public ActionEffect ToEffect()
		{
			return Type switch
			{
				EffectType.Damage => new ActionEffect_Damage
				{
					Type = EffectType.Damage,
					Description = Description,
					DamageInstances = Targets
						.Select(target => new ActionEffect_DamageEntry
						{
							Target = target,
							BaseDamage = Amount,
							DamageType = DamageType,
							DamageMultiplier = DamageMultiplier,
							Note = Description
						})
						.ToArray()
				},
				EffectType.Condition => new ActionEffect_Condition
				{
					Type = EffectType.Condition,
					Description = Description,
					Condition = Condition,
					Targets = Targets.ToArray()
				},
				EffectType.TemporaryHP => new ActionEffect_TemporaryHP
				{
					Type = EffectType.TemporaryHP,
					Description = Description,
					TemporaryHPAmount = Amount,
					Targets = Targets.ToArray()
				},
				EffectType.Heal => new ActionEffect_Heal
				{
					Type = EffectType.Heal,
					Description = Description,
					HealAmount = Amount,
					Targets = Targets.ToArray()
				},
				EffectType.Buff => new ActionEffect_Buff
				{
					Type = EffectType.Buff,
					Description = Description,
					Targets = Targets.ToArray()
				},
				_ => new ActionEffect
				{
					Type = Type,
					Description = Description
				}
			};
		}
	}
}
