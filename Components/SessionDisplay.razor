@using CampaignTracker.Model.Combats
@using CampaignTracker.Model.Creatures
@using CampaignTracker.Model.Structure

@inject IDialogService DialogService

<MudStack Spacing="3" Class="detail-display">
	<MudTabs Elevation="1" Rounded="true" Class="nested-tabs" TabPanelsClass="nested-tab-panels" Style="height: 100%; max-height: 100%;">
		<MudTabPanel Text="Session" PanelClass="nested-tab-panel">
			<MudStack Spacing="3" Class="session-detail-panel">
				<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
					<MudText Typo="Typo.h5">Session #@SessionIndex</MudText>
					<MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">
						@Session.DateUtc.ToLocalTime().ToString("d")
					</MudChip>
				</MudStack>

				<MudGrid Spacing="2">
					<MudItem xs="12" md="8">
						<MudTextField T="string" Value="@Session.Name" ValueChanged="SetSessionName" Label="Session Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
					</MudItem>
					<MudItem xs="12" md="4">
						<MudDatePicker Label="Session Date"
									   Date="LocalSessionDate"
									   DateChanged="SetLocalSessionDate"
									   Variant="Variant.Outlined"
									   Margin="Margin.Dense" />
					</MudItem>
				</MudGrid>

				<MudGrid Spacing="3" Class="session-selection-grid">
					<MudItem xs="12" md="3">
						<CreatureMultiSelect TCreature="PlayerCharacter"
											 Title="Player Characters"
											 FilterLabel="Filter players"
											 Items="Campaign.PlayerCharacters"
											 SelectedItems="Session.PlayerCharacters"
											 ItemAdded="AddPlayerCharacter"
											 ItemRemoved="RemovePlayerCharacter" />
					</MudItem>

					<MudItem xs="12" md="3">
						<CreatureMultiSelect TCreature="StaticCreature"
											 Title="NPCs"
											 FilterLabel="Filter NPCs"
											 Items="Campaign.Npcs"
											 SelectedItems="Session.Npcs"
											 ItemAdded="AddNpc"
											 ItemRemoved="RemoveNpc" />
					</MudItem>

					<MudItem xs="12" md="3">
						<CreatureMultiSelect TCreature="StaticCreature"
											 Title="Enemies"
											 FilterLabel="Filter enemies"
											 Items="Campaign.Enemies"
											 SelectedItems="Session.Enemies"
											 ItemText="EnemyText"
											 ItemAdded="AddEnemy"
											 ItemRemoved="RemoveEnemy" />
					</MudItem>

					<MudItem xs="12" md="3">
						<CreatureMultiSelect TCreature="Environmental"
											 Title="Environmentals"
											 FilterLabel="Filter environmentals"
											 Items="Campaign.Environmentals"
											 SelectedItems="Session.Environmentals"
											 ItemDisabled="IsFixedEnvironmental"
											 ItemAdded="AddEnvironmental"
											 ItemRemoved="RemoveEnvironmental" />
					</MudItem>
				</MudGrid>
			</MudStack>
		</MudTabPanel>

		<MudTabPanel Text="Stats" PanelClass="nested-tab-panel">
			<CombatStatsDisplay ScopeTitle="Session Stats"
								Campaign="Campaign"
								Combats="SessionStatsCombats" />
		</MudTabPanel>

		<MudTabPanel Text="Options" PanelClass="nested-tab-panel">
			<MudStack Spacing="2" Class="home-panel-scroll">
				<MudText Typo="Typo.subtitle1">Danger Zone</MudText>
				<MudText Typo="Typo.body2" Color="Color.Secondary">
					Delete this session and remove its references from associated combats.
				</MudText>
				<MudButton Variant="Variant.Filled"
						   Color="Color.Error"
						   StartIcon="@Icons.Material.Filled.Delete"
						   Class="campaign-config-add-button"
						   OnClick="DeleteSession">
					Delete Session
				</MudButton>
			</MudStack>
		</MudTabPanel>
	</MudTabs>
</MudStack>

@code {
	[Parameter]
	public Session Session { get; set; } = null!;

	[Parameter]
	public EventCallback<Session> SessionDeleted { get; set; }

	[Parameter]
	public EventCallback Changed { get; set; }

	private Campaign Campaign => Session.Campaign;

	private IReadOnlyCollection<Combat> SessionStatsCombats => Session.OrderedCombats.ToList();

	private int SessionIndex
	{
		get
		{
			var sortedSessions = Campaign.Sessions
				.OrderBy(session => session.DateUtc)
				.ToList();

			return sortedSessions.FindIndex(session => session.GUID == Session.GUID) + 1;
		}
	}

	private DateTime? LocalSessionDate => Session.DateUtc.ToLocalTime().Date;

	private async Task SetSessionName(string value)
	{
		Session.Name = value;
		await NotifyChanged();
	}

	private async Task SetLocalSessionDate(DateTime? value)
	{
		if (value is not DateTime localDate)
		{
			return;
		}

		Session.DateUtc = DateTime.SpecifyKind(localDate.Date, DateTimeKind.Local).ToUniversalTime();
		await NotifyChanged();
	}

	private async Task AddPlayerCharacter(PlayerCharacter playerCharacter)
	{
		Session.AddPlayerCharacter(playerCharacter);
		await NotifyChanged();
	}

	private async Task RemovePlayerCharacter(PlayerCharacter playerCharacter)
	{
		Session.RemovePlayerCharacter(playerCharacter);
		await NotifyChanged();
	}

	private async Task AddNpc(StaticCreature npc)
	{
		Session.AddNpc(npc);
		await NotifyChanged();
	}

	private async Task RemoveNpc(StaticCreature npc)
	{
		Session.RemoveNpc(npc);
		await NotifyChanged();
	}

	private async Task AddEnemy(StaticCreature enemy)
	{
		Session.AddEnemy(enemy);
		await NotifyChanged();
	}

	private async Task RemoveEnemy(StaticCreature enemy)
	{
		Session.RemoveEnemy(enemy);
		await NotifyChanged();
	}

	private async Task AddEnvironmental(Environmental environmental)
	{
		Session.AddEnvironmental(environmental);
		await NotifyChanged();
	}

	private async Task RemoveEnvironmental(Environmental environmental)
	{
		Session.RemoveEnvironmental(environmental);
		await NotifyChanged();
	}

	private static string EnemyText(StaticCreature enemy)
	{
		return enemy.ChallengeRating is null
			? enemy.DisplayName
			: $"{enemy.DisplayName} (CR {enemy.ChallengeRating.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})";
	}

	private static bool IsFixedEnvironmental(Environmental environmental)
	{
		return environmental.GUID == Environmental.Gravity.GUID;
	}

	private async Task DeleteSession()
	{
		var shouldDelete = await DialogService.ShowMessageBoxAsync(
			"Delete session?",
			"Deleting this session removes it from the campaign and removes all references to it.",
			yesText: "Delete",
			cancelText: "Cancel");

		if (shouldDelete == true)
		{
			await SessionDeleted.InvokeAsync(Session);
		}
	}

	private async Task NotifyChanged()
	{
		await Changed.InvokeAsync();
	}
}
