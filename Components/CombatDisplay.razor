@using CampaignTracker.Model.Combats
@using CampaignTracker.Model.Creatures
@using CampaignTracker.Model.Structure

@inject IDialogService DialogService

<MudStack Spacing="3" Class="detail-display">
	<MudTextField T="string" Value="@Combat.Name" ValueChanged="SetCombatName" Label="Combat Name" Variant="Variant.Outlined" Margin="Margin.Dense" />

	<MudTabs Elevation="1" Rounded="true" Class="nested-tabs" TabPanelsClass="nested-tab-panels" Style="height: 100%; max-height: 100%;">
		<MudTabPanel Text="Action Log" PanelClass="nested-tab-panel">
			<MudStack Class="home-panel-scroll">
				<CombatActionLog Combat="@Combat" Changed="Changed" />
			</MudStack>
		</MudTabPanel>

		<MudTabPanel Text="Stats" PanelClass="nested-tab-panel">
			<CombatStatsDisplay ScopeTitle="Combat Stats"
								Campaign="StatsCampaign"
								Combats="CombatStatsCombats" />
		</MudTabPanel>

		<MudTabPanel Text="Creatures" PanelClass="nested-tab-panel">
			<MudGrid Spacing="3" Class="combat-creatures-grid">
				<MudItem xs="12" md="6">
					<MudStack Spacing="2" Class="combat-player-select">
						<MudText Typo="Typo.subtitle1">Player Characters</MudText>
						<MudTextField T="string"
									  @bind-Value="_playerFilter"
									  Label="Filter players"
									  Variant="Variant.Outlined"
									  Margin="Margin.Dense"
									  Immediate="true"
									  Adornment="Adornment.Start"
									  AdornmentIcon="@Icons.Material.Filled.Search" />

						<MudStack Spacing="1" Class="creature-select-list">
							@if (!FilteredPlayerCharacters.Any())
							{
								<MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">No matching players</MudText>
							}
							else
							{
								@foreach (var playerCharacter in FilteredPlayerCharacters)
								{
									var isSelected = IsPlayerCharacterSelected(playerCharacter);

									<MudStack @key="playerCharacter.GUID" Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="combat-player-row">
										<MudCheckBox T="bool"
													 Dense="true"
													 Label="@playerCharacter.DisplayName"
													 Value="@isSelected"
													 Class="combat-player-checkbox"
													 ValueChanged="@((bool selected) => SetPlayerCharacterSelected(playerCharacter, selected))" />
										@if (isSelected)
										{
											<MudSelect T="Guid"
													   Value="@GetSelectedStatConfigurationGuid(playerCharacter)"
													   ValueChanged="@((Guid statConfigurationGuid) => SetPlayerCharacterStatConfiguration(playerCharacter, statConfigurationGuid))"
													   Dense="true"
													   Margin="Margin.Dense"
											   Variant="Variant.Outlined"
											   Class="combat-stat-select">
												@foreach (var statConfiguration in playerCharacter.StatConfigurations.OrderByDescending(statConfiguration => statConfiguration.HP))
												{
													<MudSelectItem @key="statConfiguration.GUID" T="Guid" Value="@statConfiguration.GUID">
														@statConfiguration.ClassesAndLevels (@statConfiguration.HP HP)
													</MudSelectItem>
												}
											</MudSelect>
										}
									</MudStack>
								}
							}
						</MudStack>
					</MudStack>
				</MudItem>
				<MudItem xs="12" md="2">
					<CreatureMultiSelect TCreature="StaticCreature"
										 Title="NPCs"
										 FilterLabel="Filter NPCs"
										 Items="AvailableNpcs"
										 SelectedItems="Combat.Npcs"
										 ItemAdded="AddNpc"
										 ItemRemoved="RemoveNpc" />
				</MudItem>
				<MudItem xs="12" md="2">
					<CreatureMultiSelect TCreature="StaticCreature"
										 Title="Enemies"
										 FilterLabel="Filter enemies"
										 Items="AvailableEnemies"
										 SelectedItems="Combat.Enemies"
										 ItemText="EnemyText"
										 ItemAdded="AddEnemy"
										 ItemRemoved="RemoveEnemy" />
				</MudItem>
				<MudItem xs="12" md="2">
					<CreatureMultiSelect TCreature="Environmental"
										 Title="Environmentals"
										 FilterLabel="Filter environmentals"
										 Items="AvailableEnvironmentals"
										 SelectedItems="Combat.Environmentals"
										 ItemDisabled="IsFixedEnvironmental"
										 ItemAdded="AddEnvironmental"
										 ItemRemoved="RemoveEnvironmental" />
				</MudItem>
			</MudGrid>
		</MudTabPanel>

		<MudTabPanel Text="Options" PanelClass="nested-tab-panel">
			<MudStack Spacing="2" Class="home-panel-scroll">
				<MudText Typo="Typo.subtitle1">Sessions</MudText>
				@if (Campaign is null)
				{
					<MudText Typo="Typo.body2" Color="Color.Secondary">No campaign loaded.</MudText>
				}
				else
				{
					@foreach (var session in Campaign.Sessions.OrderBy(session => session.DateUtc))
					{
						var isAssociated = Combat.Sessions.Any(existing => existing.GUID == session.GUID);

						<MudStack @key="session.GUID" Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="combat-session-row">
							<MudCheckBox T="bool"
										 Dense="true"
										 Label="@($"{session.DateUtc.ToLocalTime():d} - {session.Name}")"
										 Value="@isAssociated"
										 ValueChanged="@((bool selected) => SetSessionAssociation(session, selected))" />
							@if (isAssociated)
							{
								<MudNumericField T="int"
												 Value="@session.GetCombatIndex(Combat)"
												 ValueChanged="@((int combatIndex) => SetSessionCombatIndex(session, combatIndex))"
												 Label="Order"
												 Min="1"
												 Variant="Variant.Outlined"
												 Margin="Margin.Dense"
												 Class="combat-order-input" />
							}
						</MudStack>
					}
				}
			</MudStack>
		</MudTabPanel>
	</MudTabs>
</MudStack>

@code {
	private string _playerFilter = string.Empty;

	[Parameter]
	public Combat Combat { get; set; } = null!;

	[Parameter]
	public Campaign? Campaign { get; set; }

	[Parameter]
	public EventCallback<Combat> CombatDeleted { get; set; }

	[Parameter]
	public EventCallback CombatUpdated { get; set; }

	[Parameter]
	public EventCallback Changed { get; set; }

	private IReadOnlyCollection<PlayerCharacter> AvailablePlayerCharacters => Combat.Sessions
		.SelectMany(session => session.PlayerCharacters)
		.GroupBy(playerCharacter => playerCharacter.GUID)
		.Select(group => group.First())
		.OrderBy(playerCharacter => playerCharacter.DisplayName)
		.ToList();

	private IEnumerable<PlayerCharacter> FilteredPlayerCharacters => AvailablePlayerCharacters
		.Where(playerCharacter => string.IsNullOrWhiteSpace(_playerFilter) || playerCharacter.DisplayName.Contains(_playerFilter, StringComparison.OrdinalIgnoreCase));

	private Campaign? StatsCampaign => Campaign ?? Combat.Campaign;

	private IReadOnlyCollection<Combat> CombatStatsCombats => [Combat];

	private IReadOnlyCollection<StaticCreature> AvailableNpcs => Combat.Sessions
		.SelectMany(session => session.Npcs)
		.GroupBy(npc => npc.GUID)
		.Select(group => group.First())
		.OrderBy(npc => npc.DisplayName)
		.ToList();

	private IReadOnlyCollection<StaticCreature> AvailableEnemies => Combat.Sessions
		.SelectMany(session => session.Enemies)
		.GroupBy(enemy => enemy.GUID)
		.Select(group => group.First())
		.OrderBy(enemy => enemy.DisplayName)
		.ToList();

	private IReadOnlyCollection<Environmental> AvailableEnvironmentals => Combat.Sessions
		.SelectMany(session => session.Environmentals)
		.GroupBy(environmental => environmental.GUID)
		.Select(group => group.First())
		.OrderBy(environmental => environmental.DisplayName)
		.ToList();

	private static string EnemyText(StaticCreature enemy)
	{
		return enemy.ChallengeRating is null
			? enemy.DisplayName
			: $"{enemy.DisplayName} (CR {enemy.ChallengeRating.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})";
	}

	private static bool IsFixedEnvironmental(Environmental environmental)
	{
		return environmental.GUID == Environmental.Gravity.GUID;
	}

	private bool IsPlayerCharacterSelected(PlayerCharacter playerCharacter)
	{
		return Combat.PlayerCharacters.Any(selected => selected.GUID == playerCharacter.GUID);
	}

	private async Task SetCombatName(string value)
	{
		Combat.Name = value;
		await NotifyChanged();
	}

	private async Task SetPlayerCharacterSelected(PlayerCharacter playerCharacter, bool selected)
	{
		if (selected)
		{
			Combat.AddPlayerCharacter(playerCharacter);
		}
		else
		{
			Combat.RemovePlayerCharacter(playerCharacter);
		}

		await NotifyChanged();
	}

	private Guid GetSelectedStatConfigurationGuid(PlayerCharacter playerCharacter)
	{
		return Combat.GetSelectedStatConfiguration(playerCharacter)?.GUID ?? Guid.Empty;
	}

	private async Task SetPlayerCharacterStatConfiguration(PlayerCharacter playerCharacter, Guid statConfigurationGuid)
	{
		var statConfiguration = playerCharacter.StatConfigurations
			.FirstOrDefault(existing => existing.GUID == statConfigurationGuid);

		if (statConfiguration is not null)
		{
			Combat.SetSelectedStatConfiguration(playerCharacter, statConfiguration);
			await NotifyChanged();
		}

	}

	private async Task AddNpc(StaticCreature npc)
	{
		Combat.AddNpc(npc);
		await NotifyChanged();
	}

	private async Task RemoveNpc(StaticCreature npc)
	{
		Combat.RemoveNpc(npc);
		await NotifyChanged();
	}

	private async Task AddEnemy(StaticCreature enemy)
	{
		Combat.AddEnemy(enemy);
		await NotifyChanged();
	}

	private async Task RemoveEnemy(StaticCreature enemy)
	{
		Combat.RemoveEnemy(enemy);
		await NotifyChanged();
	}

	private async Task AddEnvironmental(Environmental environmental)
	{
		Combat.AddEnvironmental(environmental);
		await NotifyChanged();
	}

	private async Task RemoveEnvironmental(Environmental environmental)
	{
		Combat.RemoveEnvironmental(environmental);
		await NotifyChanged();
	}

	private async Task SetSessionAssociation(Session session, bool selected)
	{
		if (selected)
		{
			session.AddCombat(Combat);
			await CombatUpdated.InvokeAsync();
			return;
		}

		if (Combat.Sessions.Count <= 1)
		{
			var shouldDelete = await DialogService.ShowMessageBoxAsync(
				"Delete combat?",
				"Removing the last session from this combat will delete the combat.",
				yesText: "Delete",
				cancelText: "Cancel");

			if (shouldDelete == true)
			{
				await CombatDeleted.InvokeAsync(Combat);
			}

			return;
		}

		Combat.RemoveSession(session);
		await CombatUpdated.InvokeAsync();
	}

	private async Task SetSessionCombatIndex(Session session, int combatIndex)
	{
		session.SetCombatIndex(Combat, combatIndex);
		await CombatUpdated.InvokeAsync();
	}

	private async Task NotifyChanged()
	{
		await Changed.InvokeAsync();
	}
}
