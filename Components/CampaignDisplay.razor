@using CampaignTracker.Model.Creatures
@using CampaignTracker.Model.Structure

@inject IDialogService DialogService

<MudTabs Elevation="1" Rounded="true" Class="nested-tabs" TabPanelsClass="nested-tab-panels" Style="height: 100%; max-height: 100%;">
	<MudTabPanel Text="Player Characters" PanelClass="nested-tab-panel">
		<MudStack Spacing="3" Class="home-panel-scroll">
			<MudButton Variant="Variant.Filled"
					   Color="Color.Primary"
					   Size="Size.Small"
					   StartIcon="@Icons.Material.Filled.Add"
					   Class="campaign-config-add-button"
					   OnClick="AddPlayerCharacter">
				Add Player
			</MudButton>

			<MudGrid Spacing="2">
				@foreach (var playerCharacter in Campaign.PlayerCharacters.OrderBy(playerCharacter => playerCharacter.DisplayName).ToList())
				{
					<MudItem @key="playerCharacter.GUID" xs="12" md="6">
						<MudPaper Elevation="1" Class="pa-3 campaign-config-card">
							<MudStack Spacing="2">
								<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
									<MudTextField @bind-Value="playerCharacter.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
									<MudIconButton Icon="@Icons.Material.Filled.Delete"
												   Color="Color.Error"
												   Size="Size.Small"
												   OnClick="@(() => Campaign.RemovePlayerCharacter(playerCharacter))" />
								</MudStack>

								<MudText Typo="Typo.subtitle2">Stat Configurations</MudText>
								@foreach (var statConfiguration in playerCharacter.StatConfigurations.ToList())
								{
									<MudStack @key="statConfiguration.GUID" Row="true" AlignItems="AlignItems.Center" Spacing="2">
										<MudTextField @bind-Value="statConfiguration.ClassesAndLevels" Label="Classes / Levels" Variant="Variant.Outlined" Margin="Margin.Dense" />
										<MudNumericField T="float" @bind-Value="statConfiguration.HP" Label="HP" Variant="Variant.Outlined" Margin="Margin.Dense" />
										<MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
													   Color="Color.Default"
													   Size="Size.Small"
													   OnClick="@(() => playerCharacter.StatConfigurations.Remove(statConfiguration))" />
									</MudStack>
								}

								<MudButton Variant="Variant.Text"
										   Size="Size.Small"
										   StartIcon="@Icons.Material.Filled.Add"
										   Class="campaign-config-add-button"
										   OnClick="@(() => AddStatConfiguration(playerCharacter))">
									Add Stat Line
								</MudButton>
							</MudStack>
						</MudPaper>
					</MudItem>
				}
			</MudGrid>
		</MudStack>
	</MudTabPanel>

	<MudTabPanel Text="NPCs" PanelClass="nested-tab-panel">
		@StaticCreaturePanel(Campaign.Npcs, AddNpc, Campaign.RemoveNpc, "Add NPC")
	</MudTabPanel>

	<MudTabPanel Text="Enemies" PanelClass="nested-tab-panel">
		@StaticCreaturePanel(
			Campaign.Enemies,
			AddEnemy,
			Campaign.RemoveEnemy,
			"Add Enemy",
			OpenEnemyImportDialog,
			DuplicateEnemy,
			IsSourcedCreature)
	</MudTabPanel>
</MudTabs>

@code {
	[Parameter]
	public Campaign Campaign { get; set; } = null!;

	private void AddPlayerCharacter()
	{
		Campaign.AddPlayerCharacter(new PlayerCharacter
		{
			Name = "New Player Character",
			StatConfigurations =
			[
				new PlayerCharacterStatConfiguration
				{
					ClassesAndLevels = "Level 1",
					HP = 10
				}
			]
		});
	}

	private void AddStatConfiguration(PlayerCharacter playerCharacter)
	{
		playerCharacter.StatConfigurations.Add(new PlayerCharacterStatConfiguration
		{
			ClassesAndLevels = "Level 1",
			HP = 10
		});
	}

	private void AddNpc()
	{
		Campaign.AddNpc(new StaticCreature
		{
			Name = "New NPC",
			Stats = new CreatureStats(10, [], [])
		});
	}

	private void AddEnemy()
	{
		Campaign.AddEnemy(new StaticCreature
		{
			Name = "New Enemy",
			Stats = new CreatureStats(10, [], []),
			ChallengeRating = 1
		});
	}

	private async Task OpenEnemyImportDialog()
	{
		var parameters = new DialogParameters
		{
			["ExistingCreatureGuids"] = Campaign.Enemies.Select(enemy => enemy.GUID).ToHashSet()
		};
		var options = new DialogOptions
		{
			CloseOnEscapeKey = true,
			FullWidth = true,
			MaxWidth = MaxWidth.Large
		};

		var dialog = await DialogService.ShowAsync<StaticCreatureImportDialog>("Import Enemies", parameters, options);
		var result = await dialog.Result;

		if (result?.Canceled == false && result.Data is IReadOnlyCollection<StaticCreature> selectedCreatures)
		{
			foreach (var creature in selectedCreatures)
			{
				Campaign.AddEnemy(creature);
			}
		}
	}

	private void DuplicateEnemy(StaticCreature enemy)
	{
		Campaign.AddEnemy(CloneStaticCreature(enemy, clearSource: IsSourcedCreature(enemy)));
	}

	private static bool IsSourcedCreature(StaticCreature creature)
	{
		return !string.IsNullOrWhiteSpace(creature.Source);
	}

	private static StaticCreature CloneStaticCreature(StaticCreature creature, bool clearSource)
	{
		return new StaticCreature
		{
			Name = creature.Name,
			Stats = new CreatureStats
			{
				HP = creature.Stats.HP,
				Resistances = creature.Stats.Resistances.ToArray(),
				Vulnerabilities = creature.Stats.Vulnerabilities.ToArray()
			},
			ChallengeRating = creature.ChallengeRating,
			Source = clearSource ? null : creature.Source
		};
	}

	private RenderFragment StaticCreaturePanel(
		IReadOnlyCollection<StaticCreature> creatures,
		Action addCreature,
		Action<StaticCreature> removeCreature,
		string addButtonText,
		Func<Task>? importCreatures = null,
		Action<StaticCreature>? duplicateCreature = null,
		Func<StaticCreature, bool>? isReadOnly = null) => @<MudStack Spacing="3" Class="home-panel-scroll">
		<MudStack Row="true" Spacing="1" Class="flex-wrap">
			<MudButton Variant="Variant.Filled"
					   Color="Color.Primary"
					   Size="Size.Small"
					   StartIcon="@Icons.Material.Filled.Add"
					   Class="campaign-config-add-button"
					   OnClick="@addCreature">
				@addButtonText
			</MudButton>
			@if (importCreatures is not null)
			{
				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   Size="Size.Small"
						   StartIcon="@Icons.Material.Filled.FileDownload"
						   Class="campaign-config-add-button"
						   OnClick="@importCreatures">
					Import
				</MudButton>
			}
		</MudStack>

		@foreach (var creature in creatures.OrderBy(creature => creature.DisplayName).ToList())
		{
			var isReadOnlyCreature = isReadOnly?.Invoke(creature) == true;

			<MudPaper @key="creature.GUID" Elevation="1" Class="pa-3">
				<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
					<MudTextField @bind-Value="creature.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@isReadOnlyCreature" />
					@if (IsSourcedCreature(creature))
					{
						<MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">@creature.Source</MudChip>
					}
					<MudNumericField T="float" @bind-Value="creature.Stats.HP" Label="HP" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@isReadOnlyCreature" />
					<MudNumericField T="float?" @bind-Value="creature.ChallengeRating" Label="CR" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@isReadOnlyCreature" />
					@if (duplicateCreature is not null)
					{
						<MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
									   Color="Color.Default"
									   Size="Size.Small"
									   OnClick="@(() => duplicateCreature(creature))" />
					}
					<MudIconButton Icon="@Icons.Material.Filled.Delete"
								   Color="Color.Error"
								   Size="Size.Small"
								   OnClick="@(() => removeCreature(creature))" />
				</MudStack>
			</MudPaper>
		}
	</MudStack>;
}
