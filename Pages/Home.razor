@page "/"
@using CampaignTracker.Components
@using CampaignTracker.Model.Combats
@using CampaignTracker.Model.Structure

@inject IDataService DataService
@inject IJSRuntime JSRuntime

<PageTitle>Campaign Tracking</PageTitle>

<MudStack Spacing="4" Class="home-page">
	<MudGrid Spacing="2" Class="home-page-header">
		<MudItem xs="12" md="8">
			<MudStack Spacing="1">
				<MudText Typo="Typo.h4" HtmlTag="h1">Campaign Dashboard</MudText>
				<MudText Typo="Typo.body1">
					Track sessions, combats, player characters, NPCs, and enemies from one MudBlazor workspace.
				</MudText>
			</MudStack>
		</MudItem>
	</MudGrid>

	<MudTabs Class="home-tabs" TabPanelsClass="home-tabs-panels" Style="height: 100%; max-height: 100%;">
		<MudTabPanel Text="Stats" PanelClass="home-tab-panel">
			<MudStack Spacing="3" Class="home-panel-scroll">
				<MudGrid Spacing="2">
					<MudItem xs="12" Class="d-flex justify-end">
						<MudStack Row="true" Spacing="1" Class="flex-wrap justify-end">
							<MudButton Variant="Variant.Text"
									   Color="Color.Default"
									   Size="Size.Small"
									   OnClick="ExportButtonClicked"
									   Disabled="@(DataService.Campaign is null)">
								Export
							</MudButton>
							<MudButton Variant="Variant.Text"
									   Color="Color.Default"
									   Size="Size.Small"
									   OnClick="ImportButtonClicked">
								Import
							</MudButton>
							<MudButton Variant="Variant.Outlined"
									   Color="Color.Primary"
									   Size="Size.Small"
									   StartIcon="@Icons.Material.Filled.Add"
									   OnClick="AddSessionButtonClicked"
									   Disabled="@(DataService.Campaign is null)">
								Add Session
							</MudButton>
							<MudButton Variant="Variant.Filled"
									   Color="Color.Primary"
									   Size="Size.Small"
									   StartIcon="@Icons.Material.Filled.Add"
									   OnClick="AddCombatButtonClicked"
									   Disabled="@(DataService.Campaign is null)">
								Add Combat
							</MudButton>
						</MudStack>
					</MudItem>
				</MudGrid>

				<MudGrid Spacing="3">
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">Sessions</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.Sessions.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">Combats</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.Combats.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">Players</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.PlayerCharacters.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">NPCs</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.Npcs.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">Enemies</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.Enemies.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
				</MudGrid>
			</MudStack>
		</MudTabPanel>
		<MudTabPanel Text="Content" PanelClass="home-tab-panel">
			<MudGrid Spacing="2" Class="home-content-grid">
				<MudItem xs="12" md="3" Class="home-content-column">
					<MudPaper Elevation="1" Class="home-scroll-pane">
						<MudList T="CampaignElement">
							@if (DataService.Campaign != null)
							{
								var sortedSessions = DataService.Campaign.Sessions.OrderBy(session => session.DateUtc).ToList();

								for (int i = 0; i < sortedSessions.Count; i++)
								{
									var session = sortedSessions[i];
									<MudListItem Text=@($"Session {i + 1}: {session.Name}")
												 Value="@(CampaignElement.FromSession(session))"
												 ExpandedChanged="@(_ => SessionClicked(session))"
												 OnClick="@(() => SessionClicked(session))">
										<NestedList>
											@if (session.Combats.Count > 0)
											{
												var combats = session.Combats.OrderBy(combat => combat.Name).ToList();

												for (int j = 0; j < combats.Count; j++)
												{
													var combat = combats[j];

													<div @onclick:stopPropagation="true">
														<MudListItem Text=@(string.IsNullOrWhiteSpace(combat.Name) ? $"Combat {j + 1}" : combat.Name)
																	 Value="@(CampaignElement.FromCombat(combat))"
																	 OnClick="@(() => CombatClicked(combat))" />
													</div>
												}
											}
										</NestedList>
									</MudListItem>
								}
							}
						</MudList>
					</MudPaper>
				</MudItem>

				<MudItem xs="12" md="9" Class="home-content-column">
					<MudPaper Elevation="1" Class="pa-3 home-scroll-pane">
						<MudText>Latest selection: @LatestSelText</MudText>

						@if (LatestSel != null)
						{
							if (LatestSel.IsSession)
							{
								<SessionDisplay Session=@LatestSel.Session />
							}
							else if (LatestSel.Combat is not null)
							{
								<CombatDisplay Combat="@LatestSel.Combat" />
							}
						}
					</MudPaper>
				</MudItem>
			</MudGrid>
		</MudTabPanel>

		<MudTabPanel Text="Campaign Config" PanelClass="home-tab-panel">
			@if (DataService.Campaign is not null)
			{
				<MudPaper Elevation="1" Class="pa-3 home-fill-container">
					<MudText Typo="Typo.h5" Class="mb-2">Campaign Config</MudText>
					<CampaignDisplay Campaign="DataService.Campaign" />
				</MudPaper>
			}
		</MudTabPanel>

		<MudTabPanel Text="Data Transfer" PanelClass="home-tab-panel">
			<MudPaper Elevation="1" Class="home-fill-container">
				<MudToolBar Dense="true">
					<MudStack Row="true" Spacing="1" Class="flex-wrap justify-end">
						<MudText Typo="Typo.h6">Campaign Data</MudText>
						<MudButton Variant="Variant.Text"
								   Color="Color.Default"
								   Size="Size.Small"
								   OnClick="ExportButtonClicked"
								   Disabled="@(DataService.Campaign is null)">
							Export
						</MudButton>
						<MudButton Variant="Variant.Text"
								   Color="Color.Default"
								   Size="Size.Small"
								   OnClick="ImportButtonClicked">
							Import
						</MudButton>
					</MudStack>
					<MudSpacer />
					<MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
						JSON Preview
					</MudChip>
				</MudToolBar>
				<MudDivider />
				<pre class="campaign-json-preview">@DataService.GetCampaignString()</pre>
			</MudPaper>
		</MudTabPanel>
	</MudTabs>
</MudStack>


@code {
	private async Task ExportButtonClicked()
	{
		await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", DataService.GetCampaignString());
		DataService.ClearCampaign();
	}

	private async Task ImportButtonClicked()
	{
		try
		{
			var json = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");
			DataService.TrySetCampaignString(json);
		}
		catch (JSException)
		{
		}
	}

	private void AddSessionButtonClicked()
	{
		if (DataService.Campaign is not Campaign campaign)
		{
			return;
		}

		var nextDate = campaign.Sessions.Count == 0
			? DateTime.UtcNow
			: campaign.Sessions.Max(session => session.DateUtc).AddDays(7);

		var session = new Session(campaign)
		{
			Name = $"Session {campaign.Sessions.Count}",
			DateUtc = nextDate
		};

		LatestSel = CampaignElement.FromSession(session);
	}

	private void AddCombatButtonClicked()
	{
		if (DataService.Campaign is not Campaign campaign)
		{
			return;
		}

		var combat = new Combat(campaign)
		{
			Name = $"Combat {campaign.Combats.Count}"
		};

		if (LatestSel?.Session is { } session)
		{
			session.AddCombat(combat);
		}

		LatestSel = CampaignElement.FromCombat(combat);
	}



	public CampaignElement? LatestSel { get; set; }

	private string LatestSelText => LatestSel switch
	{
		{ IsSession: true, Session: { } session } => $"Session {session.Name}",
		{ IsSession: false, Combat: { } combat } => string.IsNullOrWhiteSpace(combat.Name) ? $"Combat {combat.GUID}" : $"Combat {combat.Name}",
		_ => "none"
	};

	private void SessionClicked(Session session)
	{
		LatestSel = CampaignElement.FromSession(session);
	}

	private void CombatClicked(Combat combat)
	{
		LatestSel = CampaignElement.FromCombat(combat);
	}


	public record CampaignElement(bool IsSession, Session? Session, Combat? Combat)
	{
		public static CampaignElement FromSession(Session session) => new(true, session, null);

		public static CampaignElement FromCombat(Combat combat) => new(false, null, combat);
	}
}
