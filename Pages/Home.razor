@page "/"
@using CampaignTracker.Components
@using CampaignTracker.Model.Combats
@using CampaignTracker.Model.Structure

@inject IDataService DataService
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<PageTitle>Campaign Tracker</PageTitle>

<MudStack Spacing="4" Class="home-page">
	<MudGrid Spacing="2" Class="home-page-header">
		<MudItem xs="12" md="8">
			<MudStack Spacing="1">
				<MudText Typo="Typo.h4" HtmlTag="h1">Campaign Dashboard</MudText>
				<MudText Typo="Typo.body1">
					A tool to track your TTRPG combats and visualize results
				</MudText>
			</MudStack>
		</MudItem>
	</MudGrid>

	<MudTabs Class="home-tabs" TabPanelsClass="home-tabs-panels" Style="height: 100%; max-height: 100%;">
		<MudTabPanel Text="Stats" PanelClass="home-tab-panel">
			<MudStack Spacing="3" Class="home-panel-scroll">
				<MudGrid Spacing="3">
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">Sessions</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.Sessions.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">Combats</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.Combats.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">Players</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.PlayerCharacters.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">NPCs</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.Npcs.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
					<MudItem xs="12" sm="6" md="3">
						<MudPaper Elevation="1" Class="pa-4">
							<MudText Typo="Typo.overline">Enemies</MudText>
							<MudText Typo="Typo.h4">@(DataService.Campaign?.Enemies.Count ?? 0)</MudText>
						</MudPaper>
					</MudItem>
				</MudGrid>
			</MudStack>
		</MudTabPanel>
		<MudTabPanel Text="Content" PanelClass="home-tab-panel">
			<MudGrid Spacing="2" Class="home-content-grid">
				<MudItem xs="4" md="3" Class="home-content-column">
					<MudPaper Elevation="1" Class="home-fill-container">
						<MudStack Spacing="0" Class="home-scroll-pane">
							@if (DataService.Campaign is not null)
							{
								var sortedSessions = DataService.Campaign.Sessions.OrderBy(session => session.DateUtc).ToList();

								for (int i = 0; i < sortedSessions.Count; i++)
								{
									var session = sortedSessions[i];
									var isExpanded = _expandedSessionGuids.Contains(session.GUID);
									int sessionId = i + 1;

									<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="campaign-element-row">
										<MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
													   Size="Size.Small"
													   OnClick="@(() => ToggleSessionExpanded(session))" />
										<MudButton Variant="Variant.Text"
												   Color="Color.Default"
												   Class="campaign-element-text-button"
												   OnClick="@(() => SessionClicked(session))">
											Session @sessionId: @session.Name
										</MudButton>
									</MudStack>

									@if (isExpanded)
									{
										foreach (var combat in session.OrderedCombats)
										{
											<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="campaign-element-row campaign-combat-row">
												<MudText Typo="Typo.caption" Color="Color.Secondary" Class="campaign-combat-index">
													@session.GetCombatIndex(combat)
												</MudText>
												<MudButton Variant="Variant.Text"
														   Color="Color.Default"
														   Class="campaign-element-text-button"
														   OnClick="@(() => CombatClicked(session, combat))">
													@(string.IsNullOrWhiteSpace(combat.Name) ? $"Combat {combat.GUID}" : combat.Name)
												</MudButton>
											</MudStack>
										}
									}
								}
							}
						</MudStack>
						<MudDivider />
						<MudStack Row="true" Spacing="1" Class="pa-2 flex-wrap">
							<MudButton Variant="Variant.Outlined"
									   Color="Color.Primary"
									   Size="Size.Small"
									   StartIcon="@Icons.Material.Filled.Add"
									   OnClick="AddSessionButtonClicked"
									   Disabled="@(DataService.Campaign is null)">
								Add Session
							</MudButton>
							<MudButton Variant="Variant.Filled"
									   Color="Color.Primary"
									   Size="Size.Small"
									   StartIcon="@Icons.Material.Filled.Add"
									   OnClick="AddCombatButtonClicked"
									   Disabled="@(!CanAddCombat)">
								Add Combat
							</MudButton>
						</MudStack>
					</MudPaper>
				</MudItem>

				<MudItem xs="8" md="9" Class="home-content-column">
					<MudPaper Elevation="1" Class="pa-3 home-scroll-pane">
						<MudText>Latest selection: @LatestSelText</MudText>

						@if (LatestSel != null)
						{
							if (LatestSel.IsSession)
							{
								<SessionDisplay Session=@LatestSel.Session SessionDeleted="SessionDeleted" />
							}
							else if (LatestSel.Combat is not null)
							{
								<CombatDisplay Combat="@LatestSel.Combat"
											   Campaign="DataService.Campaign"
											   CombatDeleted="CombatDeleted"
											   CombatUpdated="CombatUpdated" />
							}
						}
					</MudPaper>
				</MudItem>
			</MudGrid>
		</MudTabPanel>

		<MudTabPanel Text="Campaign Config" PanelClass="home-tab-panel">
			@if (DataService.Campaign is not null)
			{
				<MudPaper Elevation="1" Class="pa-3 home-fill-container">
					<MudText Typo="Typo.h5" Class="mb-2">Campaign Config</MudText>
					<CampaignDisplay Campaign="DataService.Campaign" />
				</MudPaper>
			}
		</MudTabPanel>

		<MudTabPanel Text="Data Management" PanelClass="home-tab-panel">
			<MudPaper Elevation="1" Class="home-fill-container">
				<MudToolBar Class="my-2">
					<MudText Typo="Typo.h5" Style="white-space: nowrap;">Campaign Data</MudText>

					<MudSpacer />

					<MudGrid Spacing="2">
						<MudItem xs="12" Class="d-flex justify-end">
							<MudStack Row="true" Spacing="1" Class="flex-wrap justify-end">
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Primary"
										   Size="Size.Small"
										   OnClick="ExportButtonClicked"
										   Disabled="@(DataService.Campaign is null)">
									Export
								</MudButton>
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Tertiary"
										   Size="Size.Small"
										   OnClick="ImportButtonClicked">
									Import
								</MudButton>
								
								<MudDivider Vertical Class="mx-2" />

								<MudButton Variant="Variant.Filled"
										   Color="Color.Secondary"
										   Size="Size.Small"
										   OnClick="DeleteButtonClicked">
									Delete
								</MudButton>
							</MudStack>
						</MudItem>
					</MudGrid>
				</MudToolBar>
				
				<MudDivider />
				
				<pre class="campaign-json-preview">@DataService.GetCampaignString()</pre>
			</MudPaper>
		</MudTabPanel>
	</MudTabs>
</MudStack>


@code {
	private readonly HashSet<Guid> _expandedSessionGuids = [];

	private async Task ExportButtonClicked()
	{
		await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", DataService.GetCampaignString());
		DataService.ClearCampaign();
	}

	private async Task ImportButtonClicked()
	{
		try
		{
			var json = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");
			DataService.TrySetCampaignString(json);
		}
		catch (JSException)
		{
		}
	}

	private async Task DeleteButtonClicked()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true };

		var dialog = await DialogService.ShowAsync<DeleteDialog>("Delete Dialog", options);
		var result = await dialog.Result;

		if(result != null && result.Canceled == false)
		{
			DataService.ClearCampaign();
			StateHasChanged();
		}
	}


	private void AddSessionButtonClicked()
	{
		if (DataService.Campaign is not Campaign campaign)
		{
			return;
		}

		var baseDate = LatestSel?.ParentSession?.DateUtc
			?? LatestSel?.Session?.DateUtc
			?? (campaign.Sessions.Count == 0
				? DateTime.UtcNow
				: campaign.Sessions.Max(session => session.DateUtc));

		var session = new Session(campaign)
		{
			Name = $"Session {campaign.Sessions.Count + 1}",
			DateUtc = GetNextFreeSessionDate(campaign, baseDate)
		};

		LatestSel = CampaignElement.FromSession(session);
		_expandedSessionGuids.Add(session.GUID);
	}

	private void AddCombatButtonClicked()
	{
		if (DataService.Campaign is not Campaign campaign || GetCombatInsertSession(campaign) is not Session session)
		{
			return;
		}

		var combat = new Combat(campaign)
		{
			Name = $"Combat {campaign.Combats.Count + 1}",
			ActionLog = new ActionLog()
		};

		var combatIndex = LatestSel?.Combat is { } selectedCombat && LatestSel.ParentSession?.GUID == session.GUID
			? session.GetCombatIndex(selectedCombat) + 1
			: session.OrderedCombats.Count + 1;

		session.AddCombat(combat, combatIndex);
		LatestSel = CampaignElement.FromCombat(session, combat);
		_expandedSessionGuids.Add(session.GUID);
	}



	public CampaignElement? LatestSel { get; set; }

	private bool CanAddCombat => DataService.Campaign?.Sessions.Count > 0;

	private string LatestSelText => LatestSel switch
	{
		{ IsSession: true, Session: { } session } => $"Session {session.Name}",
		{ IsSession: false, ParentSession: { } session, Combat: { } combat } => $"{session.Name} / {(string.IsNullOrWhiteSpace(combat.Name) ? $"Combat {combat.GUID}" : combat.Name)}",
		{ IsSession: false, Combat: { } combat } => string.IsNullOrWhiteSpace(combat.Name) ? $"Combat {combat.GUID}" : combat.Name,
		_ => "none"
	};

	private void SessionClicked(Session session)
	{
		LatestSel = CampaignElement.FromSession(session);
	}

	private void CombatClicked(Session session, Combat combat)
	{
		LatestSel = CampaignElement.FromCombat(session, combat);
	}

	private void ToggleSessionExpanded(Session session)
	{
		if (!_expandedSessionGuids.Add(session.GUID))
		{
			_expandedSessionGuids.Remove(session.GUID);
		}
	}

	private void SessionDeleted(Session session)
	{
		if (DataService.Campaign is not Campaign campaign)
		{
			return;
		}

		var replacement = GetPreviousCampaignElement(CampaignElement.FromSession(session));
		campaign.RemoveSession(session);
		_expandedSessionGuids.Remove(session.GUID);
		LatestSel = IsValidCampaignElement(replacement) ? replacement : null;
	}

	private void CombatDeleted(Combat combat)
	{
		if (DataService.Campaign is not Campaign campaign)
		{
			return;
		}

		var replacement = LatestSel?.Combat?.GUID == combat.GUID
			? GetPreviousCampaignElement(LatestSel)
			: LatestSel;

		campaign.RemoveCombat(combat);
		LatestSel = IsValidCampaignElement(replacement) ? replacement : null;
	}

	private void CombatUpdated()
	{
		if (LatestSel is not { Combat: { } combat } || DataService.Campaign is null)
		{
			return;
		}

		if (LatestSel.ParentSession?.Combats.Any(existing => existing.GUID == combat.GUID) == true)
		{
			return;
		}

		var parentSession = combat.Sessions
			.OrderBy(session => session.DateUtc)
			.FirstOrDefault();

		LatestSel = parentSession is null
			? null
			: CampaignElement.FromCombat(parentSession, combat);
	}

	private Session? GetCombatInsertSession(Campaign campaign)
	{
		if (LatestSel?.ParentSession is { } parentSession)
		{
			return parentSession;
		}

		if (LatestSel?.Session is { } session)
		{
			return session;
		}

		return campaign.Sessions
			.OrderBy(session => session.DateUtc)
			.LastOrDefault();
	}

	private static DateTime GetNextFreeSessionDate(Campaign campaign, DateTime baseDate)
	{
		var candidate = baseDate.AddDays(1);

		while (campaign.Sessions.Any(session => session.DateUtc.Date == candidate.Date))
		{
			candidate = candidate.AddDays(1);
		}

		return candidate;
	}

	private CampaignElement? GetPreviousCampaignElement(CampaignElement element)
	{
		if (DataService.Campaign is not Campaign campaign)
		{
			return null;
		}

		if (element.Combat is { } combat && element.ParentSession is { } parentSession)
		{
			var orderedCombats = parentSession.OrderedCombats.ToList();
			var combatIndex = orderedCombats.FindIndex(existing => existing.GUID == combat.GUID);

			return combatIndex > 0
				? CampaignElement.FromCombat(parentSession, orderedCombats[combatIndex - 1])
				: CampaignElement.FromSession(parentSession);
		}

		if (element.Session is { } session)
		{
			var sortedSessions = campaign.Sessions.OrderBy(existing => existing.DateUtc).ToList();
			var sessionIndex = sortedSessions.FindIndex(existing => existing.GUID == session.GUID);

			return sessionIndex > 0
				? CampaignElement.FromSession(sortedSessions[sessionIndex - 1])
				: null;
		}

		return null;
	}

	private bool IsValidCampaignElement(CampaignElement? element)
	{
		if (DataService.Campaign is not Campaign campaign || element is null)
		{
			return false;
		}

		return element switch
		{
			{ IsSession: true, Session: { } session } => campaign.Sessions.Any(existing => existing.GUID == session.GUID),
			{ IsSession: false, ParentSession: { } session, Combat: { } combat } => campaign.Combats.Any(existing => existing.GUID == combat.GUID)
				&& session.Combats.Any(existing => existing.GUID == combat.GUID),
			_ => false
		};
	}


	public record CampaignElement(bool IsSession, Session? Session, Combat? Combat, Session? ParentSession)
	{
		public static CampaignElement FromSession(Session session) => new(true, session, null, session);

		public static CampaignElement FromCombat(Session parentSession, Combat combat) => new(false, null, combat, parentSession);
	}
}
